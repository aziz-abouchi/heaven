-- lib/mcp/tools.hvn -- MCP tool implementations (2026-10-21)
import "stdlib/string.hvn"
import "lib/time.hvn" as T
import "lib/mcp/handlers.hvn" as M

q _ = @char_string 34

find_str_from s pat i =
  if i + (string_length pat) > (string_length s) then 0 - 1
  else if (string_matches_at s i pat) then i
  else find_str_from s pat (i + 1)

find_quote_from s i =
  if i >= (string_length s) then 0 - 1
  else if (peek_byte (string_ptr s) i) == 34 then i
  else find_quote_from s (i + 1)

str_val_2 s vs =
  if (find_quote_from s vs) < 0 then ""
  else string_substring s vs ((find_quote_from s vs) - vs)
str_val s start =
  if start >= (string_length s) then ""
  else if (peek_byte (string_ptr s) start) != 34 then ""
  else str_val_2 s (start + 1)

text_pat _ = (q 0) + "text" + (q 0) + ":"
name_pat _ = (q 0) + "name" + (q 0) + ":"

extract_text body =
  if (find_str_from body (text_pat 0) 0) < 0 then ""
  else str_val body ((find_str_from body (text_pat 0) 0) + (string_length (text_pat 0)))

extract_name body =
  if (find_str_from body (name_pat 0) 0) < 0 then ""
  else str_val body ((find_str_from body (name_pat 0) 0) + (string_length (name_pat 0)))

run_echo body = extract_text body
run_time _ = int_to_string (T.now_sec 0)

w_echo body = run_echo body
w_time body = run_time 0

run_tool body =
  if (extract_name body) == "echo" then w_echo body
  else if (extract_name body) == "time_now" then w_time body
  else "unknown tool"

handle_tools_call i body = M.tool_call_body i (run_tool body)
