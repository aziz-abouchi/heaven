-- lib/mcp/tools.hvn -- MCP tool implementations (2026-10-21)
import "stdlib/string.hvn"
import "lib/time.hvn" as T
import "lib/mcp/handlers.hvn" as M
import "lib/web/ontology.hvn" as WO

q _ = @char_string 34

find_str_from s pat i =
  if i + (string_length pat) > (string_length s) then 0 - 1
  else if (string_matches_at s i pat) then i
  else find_str_from s pat (i + 1)

find_quote_from s i =
  if i >= (string_length s) then 0 - 1
  else if (peek_byte (string_ptr s) i) == 34 then i
  else find_quote_from s (i + 1)

str_val_2 s vs =
  if (find_quote_from s vs) < 0 then ""
  else string_substring s vs ((find_quote_from s vs) - vs)
str_val s start =
  if start >= (string_length s) then ""
  else if (peek_byte (string_ptr s) start) != 34 then ""
  else str_val_2 s (start + 1)

text_pat _ = (q 0) + "text" + (q 0) + ":"
name_pat _ = (q 0) + "name" + (q 0) + ":"
path_pat _ = (q 0) + "path" + (q 0) + ":"

extract_at body pat_str =
  if (find_str_from body pat_str 0) < 0 then ""
  else str_val body ((find_str_from body pat_str 0) + (string_length pat_str))
extract_text body = extract_at body (text_pat 0)
extract_name body = extract_at body (name_pat 0)
extract_path body = extract_at body (path_pat 0)

-- Tool implementations
run_echo body = extract_text body
run_time_sec _ = int_to_string (T.now_sec 0)
run_time_ms _ = int_to_string (T.now_ms 0)
run_fs_read body = @fs_read "fs:read" (extract_path body)
run_count body = int_to_string (string_length (extract_text body))

-- Wrappers locaux (evite le bug qualifie-direct dans if)
w_echo body = run_echo body
w_time_sec body = run_time_sec 0
w_time_ms body = run_time_ms 0
w_fs body = run_fs_read body
w_count body = run_count body

-- Dispatch "precalcul + pick" (contourne le bug dispatch)
precalc body =
  let n = extract_name body in
  let e = w_echo body in
  let t = w_time_sec body in
  let m = w_time_ms body in
  let f = w_fs body in
  let c = w_count body in
  pick n e t m f c

pick n e t m f c =
  if n == "echo" then e
  else if n == "time_now" then t
  else if n == "time_ms" then m
  else if n == "fs_read" then f
  else if n == "count_chars" then c
  else "unknown tool"

run_tool body = precalc body

handle_tools_call i body = M.tool_call_body i (run_tool body)



-- Tool web_lookup (DBpedia live)
run_web_lookup body = WO.lookup_label (extract_text body)
w_web body = run_web_lookup body

-- Override precalc/pick pour 6 tools
precalc body =
  let n = extract_name body in
  let e = w_echo body in
  let t = w_time_sec body in
  let m = w_time_ms body in
  let f = w_fs body in
  let c = w_count body in
  let w = w_web body in
  pick6 n e t m f c w

pick6 n e t m f c w =
  if n == "echo" then e
  else if n == "time_now" then t
  else if n == "time_ms" then m
  else if n == "fs_read" then f
  else if n == "count_chars" then c
  else if n == "web_lookup" then w
  else "unknown tool"
