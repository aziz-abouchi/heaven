-- lib/mcp/handlers.hvn -- MCP method handlers (2026-10-21)
q _ = @char_string 34
qstr s = (q 0) + s + (q 0)
n2s n = int_to_string n

resp i r =
  "{" + qstr "jsonrpc" + ":" + qstr "2.0" + "," +
  qstr "id" + ":" + n2s i + "," +
  qstr "result" + ":" + r + "}"

init_result _ =
  "{" +
    qstr "protocolVersion" + ":" + qstr "2024-11-05" + "," +
    qstr "capabilities" + ":{" + qstr "tools" + ":{" + "}}" + "," +
    qstr "serverInfo" + ":{" +
      qstr "name" + ":" + qstr "heaven" + "," +
      qstr "version" + ":" + qstr "0.1" +
    "}" +
  "}"
init_body i = resp i (init_result 0)

tool_def name desc =
  "{" + qstr "name" + ":" + qstr name + "," +
  qstr "description" + ":" + qstr desc + "," +
  qstr "inputSchema" + ":{" + qstr "type" + ":" + qstr "object" + "}}"

tools_list_inner _ =
  "{" + qstr "tools" + ":[" +
  (tool_def "echo" "Echoes text") + "," +
  (tool_def "time_now" "Unix timestamp seconds") + "," +
  (tool_def "time_ms" "Unix timestamp milliseconds") + "," +
  (tool_def "fs_read" "Read file by path") + "," +
  (tool_def "count_chars" "Count chars in text") + "," +
  (tool_def "web_lookup" "DBpedia label by name") +
  "]}"
tools_list_body i = resp i (tools_list_inner 0)

tool_result txt =
  "{" + qstr "content" + ":[{" +
    qstr "type" + ":" + qstr "text" + "," +
    qstr "text" + ":" + qstr txt +
  "}]}"
tool_call_body i txt = resp i (tool_result txt)
