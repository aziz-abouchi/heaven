-- lib/codegen/c.hvn -- Générateur C (E2)
import "lib/heaven_parse.hvn" as HP

fmt_let var val body = Str.concat "({ int " (Str.concat var (Str.concat " = " (Str.concat val (Str.concat "; " (Str.concat body "; })")))))
fmt_if c t f = Str.concat "(" (Str.concat c (Str.concat " ? " (Str.concat t (Str.concat " : " (Str.concat f ")")))))
fmt_bin op a b = Str.concat "(" (Str.concat a (Str.concat " " (Str.concat op (Str.concat " " (Str.concat b ")")))))

emit_expr (HP.ELitI n) = Str.from_int n
emit_expr (HP.ELitS s) = Str.concat "\"" (Str.Voici une version nettoyée et très lisible de `lib/codegen/c.hvn` et `lib/parse/infix.hvn` utilisant de petits utilitaires de concaténation (`cat3`, `cat5`) pour éliminer la répétition de `Str.concat`.

### Commandes à copier/coller :

```bash
# 1. Mise à jour de lib/codegen/c.hvn avec utilitaires cat3 / cat5
cat << 'EOF' > lib/codegen/c.hvn
-- lib/codegen/c.hvn -- Générateur C (E2)
import "lib/heaven_parse.hvn" as HP

cat2 a b = Str.concat a b
cat3 a b c = Str.concat a (Str.concat b c)
cat5 a b c d e = cat3 a b (cat3 c d e)

emit_expr (HP.ELitI n) = Str.from_int n
emit_expr (HP.ELitS s) = cat3 "\"" s "\""
emit_expr (HP.ESym s)  = s
emit_expr (HP.EApply f x) = emit_app f x
emit_expr _ = "0"

emit_app (HP.EApply f a) b = emit_app2 f a b
emit_app (HP.ELambda var body) val = cat5 "({ int " var " = " (emit_expr val) (cat3 "; " (emit_expr body) "; })")
emit_app _ _ = "0"

emit_app2 (HP.EApply (HP.ESym "if") c) t f = cat5 "(" (emit_expr c) " ? " (emit_expr t) (cat3 " : " (emit_expr f) ")")
emit_app2 (HP.ESym op) a b = cat5 "(" (emit_expr a) (cat3 " " op " ") (emit_expr b) ")"
emit_app2 _ _ _ = "0"

emit_c_program ast = cat3 "#include <stdio.h>\n\nint main() {\n    printf(\"%d\\n\", " (emit_expr ast) ");\n    return 0;\n}\n"
