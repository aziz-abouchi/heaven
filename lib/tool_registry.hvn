-- lib/tool_registry.hvn — Heaven Tool Registry v2 (2026-11-09)
-- RFC : docs/spec/_rfc_utcp_mcp.md
-- 5e champ : kind (0 = heaven pur, 1 = native Zig)
-- Voir _check_validator_bug.md, _module_value_ref_bug.md,
-- _if_qualified_bug.md (multi-arg pattern), _integrate_bug.md

import "lib/std/result.hvn" as R

data Tool = Tool Str Str Int Int Int
data ToolList = TLNil | TLCons Tool ToolList

tool_name   (Tool n d p e k) = n
tool_desc   (Tool n d p e k) = d
tool_perms  (Tool n d p e k) = p
tool_effect (Tool n d p e k) = e
tool_kind   (Tool n d p e k) = k

-- ── Schémas d'entrée détaillés (Session 47, B5) ──
-- Le registre ne stocke pas le JSON Schema dans `data Tool` (6ᵉ champ
-- = ~32 littéraux à modifier). On le fournit par une if-chain 16 branches,
-- comme find_by_name. Source de vérité unique.
schema_for "echo" = "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
schema_for "time_now" = "{\"type\":\"object\",\"properties\":{}}"
schema_for "time_ms" = "{\"type\":\"object\",\"properties\":{}}"
schema_for "fs_read" = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}"
schema_for "count_chars" = "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
schema_for "heaven_eval" = "{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\",\"description\":\"Heaven expression to evaluate\"}},\"required\":[\"expression\"]}"
schema_for "heaven_derive" = "{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\"},\"variable\":{\"type\":\"string\",\"default\":\"x\"}},\"required\":[\"expression\"]}"
schema_for "heaven_integrate" = "{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\"},\"variable\":{\"type\":\"string\",\"default\":\"x\"}},\"required\":[\"expression\"]}"
schema_for "heaven_solve" = "{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\"},\"variable\":{\"type\":\"string\",\"default\":\"x\"}},\"required\":[\"expression\"]}"
schema_for "heaven_expand" = "{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\"}},\"required\":[\"expression\"]}"
schema_for "heaven_simplify" = "{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\"}},\"required\":[\"expression\"]}"
schema_for "heaven_theorems" = "{\"type\":\"object\",\"properties\":{}}"
schema_for "mlcpd_parse" = "{\"type\":\"object\",\"properties\":{\"json\":{\"type\":\"string\",\"description\":\"MLCPD JSON data\"}},\"required\":[\"json\"]}"
schema_for "mlcpd_equiv" = "{\"type\":\"object\",\"properties\":{\"json1\":{\"type\":\"string\"},\"json2\":{\"type\":\"string\"}},\"required\":[\"json1\",\"json2\"]}"
schema_for "egraph_query" = "{\"type\":\"object\",\"properties\":{\"expr\":{\"type\":\"string\"}},\"required\":[\"expr\"]}"
schema_for "heaven_prove" = "{\"type\":\"object\",\"properties\":{\"statement\":{\"type\":\"string\",\"description\":\"Theorem or equivalence to prove\"}},\"required\":[\"statement\"]}"
schema_for _ = "{\"type\":\"object\"}"

-- 16 tools = 5 heaven + 11 native.
-- Convention : perms (0 = pure, 1 = read, 5 = exec), effect (0 = pure,
-- 1 = IO/impure).
registry_builtin _ =
  TLCons
    (Tool "echo" "Echoes text" 0 0 0)
    (TLCons
      (Tool "time_now" "Unix timestamp seconds" 0 1 0)
      (TLCons
        (Tool "time_ms" "Unix timestamp milliseconds" 0 1 0)
        (TLCons
          (Tool "fs_read" "Read file by path" 1 1 0)
          (TLCons
            (Tool "count_chars" "Count chars in text" 0 0 0)
            (TLCons
              (Tool "heaven_eval" "Evaluate a Heaven expression" 0 0 1)
              (TLCons
                (Tool "heaven_derive" "Symbolic derivative" 0 0 1)
                (TLCons
                  (Tool "heaven_integrate" "EXPERIMENTAL - incorrect results" 0 0 1)
                  (TLCons
                    (Tool "heaven_solve" "Solve equation for variable" 0 0 1)
                    (TLCons
                      (Tool "heaven_expand" "Expand algebraic expression" 0 0 1)
                      (TLCons
                        (Tool "heaven_simplify" "Simplify expression" 0 0 1)
                        (TLCons
                          (Tool "heaven_theorems" "List axioms and theorems" 0 0 1)
                          (TLCons
                            (Tool "mlcpd_parse" "Parse MLCPD universal AST" 0 0 1)
                            (TLCons
                              (Tool "mlcpd_equiv" "MLCPD structural equivalence" 0 0 1)
                              (TLCons
                                (Tool "egraph_query" "Query EGraph saturation" 0 0 1)
                                (TLCons
                                  (Tool "heaven_prove" "Kernel tactics or semantic equality" 0 0 1)
                                  TLNil)))))))))))))))

registry_count TLNil = 0
registry_count (TLCons t rest) = (+ 1 (registry_count rest))

-- If-chain (Bug D : multi-arg pattern ne dispatche pas en v0).
registry_find_by_name name =
  if name == "echo" then (R.Ok (Tool "echo" "Echoes text" 0 0 0))
  else if name == "time_now" then (R.Ok (Tool "time_now" "Unix timestamp seconds" 0 1 0))
  else if name == "time_ms" then (R.Ok (Tool "time_ms" "Unix timestamp milliseconds" 0 1 0))
  else if name == "fs_read" then (R.Ok (Tool "fs_read" "Read file by path" 1 1 0))
  else if name == "count_chars" then (R.Ok (Tool "count_chars" "Count chars in text" 0 0 0))
  else if name == "heaven_eval" then (R.Ok (Tool "heaven_eval" "Evaluate a Heaven expression" 0 0 1))
  else if name == "heaven_derive" then (R.Ok (Tool "heaven_derive" "Symbolic derivative" 0 0 1))
  else if name == "heaven_integrate" then (R.Ok (Tool "heaven_integrate" "EXPERIMENTAL - incorrect results" 0 0 1))
  else if name == "heaven_solve" then (R.Ok (Tool "heaven_solve" "Solve equation for variable" 0 0 1))
  else if name == "heaven_expand" then (R.Ok (Tool "heaven_expand" "Expand algebraic expression" 0 0 1))
  else if name == "heaven_simplify" then (R.Ok (Tool "heaven_simplify" "Simplify expression" 0 0 1))
  else if name == "heaven_theorems" then (R.Ok (Tool "heaven_theorems" "List axioms and theorems" 0 0 1))
  else if name == "mlcpd_parse" then (R.Ok (Tool "mlcpd_parse" "Parse MLCPD universal AST" 0 0 1))
  else if name == "mlcpd_equiv" then (R.Ok (Tool "mlcpd_equiv" "MLCPD structural equivalence" 0 0 1))
  else if name == "egraph_query" then (R.Ok (Tool "egraph_query" "Query EGraph saturation" 0 0 1))
  else if name == "heaven_prove" then (R.Ok (Tool "heaven_prove" "Kernel tactics or semantic equality" 0 0 1))
  else (R.Err "not found")

registry_has name = (R.result_is_ok (registry_find_by_name name))

-- ── Sérialisation JSON (Session 46, pour MCP tools/list) ──
-- Le registre est la source de vérité. Cette section produit
-- {"tools":[{...},...]} consommable directement par un serveur MCP.
-- Voir docs/spec/_registry_autoritaire_plan.md (à venir).

q _ = @char_string 34
qstr s = (q 0) + s + (q 0)
n2s n = int_to_string n

tool_to_json (Tool n d p e k) =
  "{" + qstr "name" + ":" + qstr n + "," +
        qstr "description" + ":" + qstr d + "," +
        qstr "kind" + ":" + n2s k + "," +
        qstr "inputSchema" + ":" + (schema_for n) +
  "}"

is_empty_list TLNil = true
is_empty_list _ = false

tool_list_json TLNil = ""
tool_list_json (TLCons t rest) =
  (tool_to_json t) +
  (if (is_empty_list rest) then "" else ",") +
  (tool_list_json rest)

-- Point d'entrée : "{"tools":[tool0,...,tool15]}"
registry_to_json _ = "{" + qstr "tools" + ":[" + (tool_list_json (registry_builtin 0)) + "]}"

