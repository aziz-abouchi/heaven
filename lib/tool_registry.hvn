-- lib/tool_registry.hvn — Heaven Tool Registry v2 (2026-11-09)
-- RFC : docs/spec/_rfc_utcp_mcp.md
-- 5e champ : kind (0 = heaven pur, 1 = native Zig)
-- Voir _check_validator_bug.md, _module_value_ref_bug.md,
-- _if_qualified_bug.md (multi-arg pattern), _integrate_bug.md

import "lib/std/result.hvn" as R

data Tool = Tool Str Str Int Int Int
data ToolList = TLNil | TLCons Tool ToolList

tool_name   (Tool n d p e k) = n
tool_desc   (Tool n d p e k) = d
tool_perms  (Tool n d p e k) = p
tool_effect (Tool n d p e k) = e
tool_kind   (Tool n d p e k) = k

-- 16 tools = 5 heaven + 11 native.
-- Convention : perms (0 = pure, 1 = read, 5 = exec), effect (0 = pure,
-- 1 = IO/impure).
registry_builtin _ =
  TLCons
    (Tool "echo" "Echoes text" 0 0 0)
    (TLCons
      (Tool "time_now" "Unix timestamp seconds" 0 1 0)
      (TLCons
        (Tool "time_ms" "Unix timestamp milliseconds" 0 1 0)
        (TLCons
          (Tool "fs_read" "Read file by path" 1 1 0)
          (TLCons
            (Tool "count_chars" "Count chars in text" 0 0 0)
            (TLCons
              (Tool "heaven_eval" "Evaluate a Heaven expression" 0 0 1)
              (TLCons
                (Tool "heaven_derive" "Symbolic derivative" 0 0 1)
                (TLCons
                  (Tool "heaven_integrate" "Symbolic integral" 0 0 1)
                  (TLCons
                    (Tool "heaven_solve" "Solve equation for variable" 0 0 1)
                    (TLCons
                      (Tool "heaven_expand" "Expand algebraic expression" 0 0 1)
                      (TLCons
                        (Tool "heaven_simplify" "Simplify expression" 0 0 1)
                        (TLCons
                          (Tool "heaven_theorems" "List axioms and theorems" 0 0 1)
                          (TLCons
                            (Tool "mlcpd_parse" "Parse MLCPD universal AST" 0 0 1)
                            (TLCons
                              (Tool "mlcpd_equiv" "MLCPD structural equivalence" 0 0 1)
                              (TLCons
                                (Tool "egraph_query" "Query EGraph saturation" 0 0 1)
                                (TLCons
                                  (Tool "heaven_prove" "Prove statement (semantic)" 0 0 1)
                                  TLNil)))))))))))))))

registry_count TLNil = 0
registry_count (TLCons t rest) = (+ 1 (registry_count rest))

-- If-chain (Bug D : multi-arg pattern ne dispatche pas en v0).
registry_find_by_name name =
  if name == "echo" then (R.Ok (Tool "echo" "Echoes text" 0 0 0))
  else if name == "time_now" then (R.Ok (Tool "time_now" "Unix timestamp seconds" 0 1 0))
  else if name == "time_ms" then (R.Ok (Tool "time_ms" "Unix timestamp milliseconds" 0 1 0))
  else if name == "fs_read" then (R.Ok (Tool "fs_read" "Read file by path" 1 1 0))
  else if name == "count_chars" then (R.Ok (Tool "count_chars" "Count chars in text" 0 0 0))
  else if name == "heaven_eval" then (R.Ok (Tool "heaven_eval" "Evaluate a Heaven expression" 0 0 1))
  else if name == "heaven_derive" then (R.Ok (Tool "heaven_derive" "Symbolic derivative" 0 0 1))
  else if name == "heaven_integrate" then (R.Ok (Tool "heaven_integrate" "Symbolic integral" 0 0 1))
  else if name == "heaven_solve" then (R.Ok (Tool "heaven_solve" "Solve equation for variable" 0 0 1))
  else if name == "heaven_expand" then (R.Ok (Tool "heaven_expand" "Expand algebraic expression" 0 0 1))
  else if name == "heaven_simplify" then (R.Ok (Tool "heaven_simplify" "Simplify expression" 0 0 1))
  else if name == "heaven_theorems" then (R.Ok (Tool "heaven_theorems" "List axioms and theorems" 0 0 1))
  else if name == "mlcpd_parse" then (R.Ok (Tool "mlcpd_parse" "Parse MLCPD universal AST" 0 0 1))
  else if name == "mlcpd_equiv" then (R.Ok (Tool "mlcpd_equiv" "MLCPD structural equivalence" 0 0 1))
  else if name == "egraph_query" then (R.Ok (Tool "egraph_query" "Query EGraph saturation" 0 0 1))
  else if name == "heaven_prove" then (R.Ok (Tool "heaven_prove" "Prove statement (semantic)" 0 0 1))
  else (R.Err "not found")

registry_has name = (R.result_is_ok (registry_find_by_name name))
