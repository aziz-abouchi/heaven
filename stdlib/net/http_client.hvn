-- stdlib/net/http_client.hvn — HTTP client V0 (2026-10-19)
-- GET simple. V0 : pas de redirect, pas de chunked, pas de TLS.
-- http_get : non testable en sandbox (reseau). http_parse_* :
-- testables sur fixture string.

import "stdlib/string.hvn"
import "stdlib/net/tcp.hvn"

-- Parse "HTTP/1.1 200 OK\r\n..." -> 200 (0 si invalide)
_parse_status s i acc =
  if (>= i (string_length s)) then 0
  else if (= (string_char_at s i) 32) then acc
  else if (>= (string_char_at s i) 48) then
    (if (<= (string_char_at s i) 57)
      (_parse_status s (+ i 1) (+ (* acc 10) (- (string_char_at s i) 48)))
      acc)
  else acc
_skip_to_space s i =
  if (>= i (string_length s)) then i
  else if (= (string_char_at s i) 32) then (+ i 1)
  else (_skip_to_space s (+ i 1))
http_parse_status raw = (_parse_status raw (_skip_to_space raw 0) 0)

-- Parse body : apres la premiere sequence \r\n\r\n
_find_sep s i =
  if (>= (+ i 3) (string_length s)) then (- 0 1)
  else if (= (string_char_at s i) 13) then
    (if (= (string_char_at s (+ i 1)) 10) then
      (if (= (string_char_at s (+ i 2)) 13) then
        (if (= (string_char_at s (+ i 3)) 10) then i else (_find_sep s (+ i 1)))
        else (_find_sep s (+ i 1)))
      else (_find_sep s (+ i 1)))
  else (_find_sep s (+ i 1))
http_parse_body raw =
  let p = (_find_sep raw 0) in
  if (< p 0) then ""
  else (string_substring raw (+ p 4) (- (string_length raw) (+ p 4)))

-- Construit la requete GET
http_build_get host path =
  (string_concat "GET "
    (string_concat path
      (string_concat " HTTP/1.1\r\nHost: "
        (string_concat host "\r\nConnection: close\r\n\r\n"))))

-- Variante avec User-Agent (requis par Wikidata/DBpedia)
http_build_get_ua host path =
  "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nUser-Agent: Heaven\r\nConnection: close\r\n\r\n"

-- Envoi + lecture (reseau requis, sandbox bloque)
http_get host port path =
  let sock_cap = (cap_acquire "net:socket") in
  let conn_cap = (cap_acquire "net:connect") in
  let read_cap = (cap_acquire "net:read") in
  let write_cap = (cap_acquire "net:write") in
  let close_cap = (cap_acquire "net:close") in
  let fd = (net_connect conn_cap host port) in
  let req = (http_build_get host path) in
  let _ = (net_write write_cap fd req) in
  let resp = (net_read read_cap fd) in
  let _ = (net_close close_cap fd) in
  resp
