-- stdlib/string.hvn — helpers string partages (2026-10-19)
-- Extraits de stdlib/net.hvn pour reutilisation autonome.

string_matches_at s i sep =
  if (>= (+ i (string_length sep)) (string_length s)) then false
  else if (= (string_substring s i (string_length sep)) sep) then true
  else false

string_split s sep = (string_split_from s sep 0 0)
string_split_from s sep start i =
  if (>= i (string_length s)) then (if (< start i) (cons (string_substring s start (- i start)) nil) nil)
  else if (string_matches_at s i sep) then (cons (string_substring s start (- i start)) (string_split_from s sep (+ i (string_length sep)) (+ i (string_length sep))))
  else (string_split_from s sep start (+ i 1))

string_eq_from a b i =
  (if (= i (string_length a))
    true
    (if (= (peek_byte (string_ptr a) i) (peek_byte (string_ptr b) i))
      (string_eq_from a b (+ i 1))
      false))

string_eq a b =
  (if (= (string_length a) (string_length b))
    (string_eq_from a b 0)
    false)

string_starts_with s prefix = (if (> (string_length prefix) (string_length s)) false ((string_substring s 0 (string_length prefix)) == prefix))

-- string_ends_with : true si s finit par suffix, false sinon.
-- Retourne Bool (comme string_eq, string_matches_at), pas Int,
-- pour etre utilisable directement dans `if (string_ends_with ...)`.
string_ends_with s suffix = (if (> (string_length suffix) (string_length s)) false ((string_substring s (- (string_length s) (string_length suffix)) (string_length suffix)) == suffix))
