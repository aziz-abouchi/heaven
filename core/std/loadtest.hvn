-- core/std/loadtest.hvn — Charge in-process (v2, 2026-10-28).
-- v2 : `let many next` force l'état à chaque itération.
-- Sans `let many`, `(fn state)` peut binder un thunk et le cas de
-- base retourne le thunk au lieu de la valeur (test `!= 100`).
-- Note TCO : la récursion n'est PAS TCO'd (récursion dans un let-in).
-- Limite pratique : ~200 iters avant stack overflow (8 MB macOS,
-- ~40 KB/frame). Documenté dette Phase 7 (fix TCO let-in).
loadtest_run fn state 0 = state
loadtest_run fn state n =
  (let many next = (fn state) in
   (loadtest_run fn next (- n 1)))

loadtest_iter fn state 0 = 0
loadtest_iter fn state n =
  (let many _ = (fn state) in
   (+ 1 (loadtest_iter fn state (- n 1))))
