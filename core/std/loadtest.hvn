-- core/std/loadtest.hvn — Charge in-process (v3, 2026-10-28)
-- v3 : self-call DIRECT avec `force` (au lieu de `let many`).
-- Phase 7 : TCO if/seq/block OK, let+self-call SIGSEGV (Phase 7b).
-- (force (fn state)) force l'evaluation, self-call en queue directe
-- => TCO'd. 10000 iters OK.
loadtest_run fn state 0 = state
loadtest_run fn state n = (loadtest_run fn (force (fn state)) (- n 1))

loadtest_iter fn state 0 = 0
loadtest_iter fn state n = (+ 1 (loadtest_iter fn (force (fn state)) (- n 1)))
