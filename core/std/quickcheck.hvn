-- core/std/quickcheck.hvn (Quickchecker v1)
--
-- Property-based testing minimaliste : PRNG pur déterministe, 3
-- générateurs, un combinateur `check`. 0 ligne Zig.
--
-- Déterministe : seed fixe (1), même séquence à chaque exécution.
-- Reproductible. Pas de shrinking (v2), pas de report de la valeur
-- fautive (v2). Voir docs/spec/_quickcheck.md.

-- PRNG : Lehmer MINSTD (Park & Miller, 1988).
-- a = 16807, m = 2^31 - 1 = 2147483647. Seed initial = 1.
-- Qualité suffisante pour du test (pas pour la crypto).
-- Invariant : seed dans [1, m-1] ; next(0) = 0 (cycle trivial).

next seed = (mod (* 16807 seed) 2147483647)

-- gen_int seed : entier dans [0, m-1].
gen_int seed = (next seed)

-- gen_bool seed : Bool (alternance pair/impair).
gen_bool seed = (= (mod (next seed) 2) 0)

-- gen_range lo hi seed : entier dans [lo, hi] inclus.
-- Requiert lo <= hi (retourne lo sinon).
gen_range lo hi seed =
  (if (> lo hi) lo (+ lo (mod (next seed) (+ (- hi lo) 1))))

-- check_iter : une itération du combinateur.
-- Évalue (prop (gen s)), récurse si vrai.
check_iter prop gen i n s =
  (if (>= i n) true
    (if (prop (gen s)) (check_iter prop gen (+ i 1) n (next s)) false))

-- check prop gen n : exécute prop sur n valeurs générées.
-- Retourne true si toutes passent, false sinon.
-- Génère à partir de seed=1, déterministe.
check prop gen n = (check_iter prop gen 0 n 1)
