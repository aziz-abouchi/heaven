-- core/std/lens.hvn (optiques v1 — 2026-10-29)
-- Uniquement les fonctions validées par tests/optics/.
-- compose_lens, prism, iso, traversal : voir _runtime_gaps.md.
-- fst-in-lambda bug : compose_lens ne fonctionne pas.

-- ─── Construction ───
lens get set = (pair get set)

-- ─── Opérations de base ───
view l s = ((fst l) s)
set_via l v s = (((snd l) v) s)
over l f s = (((snd l) (f (view l s))) s)

-- ─── Lenses pour Pair ───
set_fst v p = (pair v (snd p))
set_snd v p = (pair (fst p) v)

lens_fst _ = (lens fst set_fst)
lens_snd _ = (lens snd set_snd)

-- ─── Lens profonde (Pair (Pair a b) c) — 1 niveau manuel ───
get_pp_fst p = (fst (fst p))
set_pp_fst v p =
  (let many inner = (fst p) in
   (pair (pair v (snd inner)) (snd p)))

lens_pp_fst _ = (lens get_pp_fst set_pp_fst)

-- ─── Composition (getter seulement, setter manuel) ───
-- compose_getter o i s : applique getter inner ∘ getter outer
compose_getter o i s = ((fst i) ((fst o) s))

-- compose_lens : cassé par fst-in-lambda bug runtime.
