-- core/std/otp/gen_server.hvn — O1 (GenServer drain-coopératif, infixe)
--
-- Note parser : `lambda a b. body` ne parse PAS en lambda à 2 params
-- (devient 3 lambdas imbriqués). Utiliser `fn name(a, b) = body`, comme
-- dans src/vessel/public/test_suite.hvn (counterHandler).
--
-- Préemption SIGALRM + fuel-check existe, sans captureCont (STATUS.md:303).
-- `run pid` reste nécessaire pour drainer. O2 (3a-3b) retirera `run`.
--
-- Protocole (MPST biparti) :
--   Client → Server : cast(f)          -- !Cast
--   Client → Server : call(f)          -- !Call
--   Server → Client : état résultant   -- !Reply (via run)

fn gen_server_step(state, msg) = msg state

gen_server_spawn init = spawn gen_server_step init

gen_server_cast pid f = tell pid f

gen_server_call pid f =
  let _ = tell pid f in
  run pid
