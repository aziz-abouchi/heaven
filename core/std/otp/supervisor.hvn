-- core/std/otp/supervisor.hvn — O2.1 + O2.2 + O2.4
-- O2.1 : one_for_one (polling, Endofunctor S : End(Children), S∘S=S).
-- O2.2 : one_for_all / rest_for_one, dispatch HKT ∀h.(h,C)→C.
-- O2.4 : event-driven link+trap_exit, sup reçoit EXIT passivement.

-- ═══ O2.1 : one_for_one ═══

sup_make h nil = nil
sup_make h (cons init rest) =
  (cons (pair (spawn h init) init) (sup_make h rest))

sup_restart h nil = nil
sup_restart h (cons c rest) =
  (if (is_alive (fst c))
    (cons c (sup_restart h rest))
    (cons (pair (spawn h (snd c)) (snd c)) (sup_restart h rest)))

sup_restart_one h c = (sup_restart h c)

sup_tick_fn state =
  (pair (fst state) (sup_restart (fst state) (snd state)))

sup_spawn h inits =
  (gen_server_spawn (pair h (sup_make h inits)))

sup_tick sup =
  (let many _ = (gen_server_cast sup sup_tick_fn) in
   (run sup))

sup_count_alive nil = 0
sup_count_alive (cons c rest) =
  (if (is_alive (fst c))
    (1 + sup_count_alive rest)
    (sup_count_alive rest))

-- ═══ O2.2 : stratégies polymorphes ═══

sup_any_dead nil = false
sup_any_dead (cons c rest) =
  (if (is_alive (fst c)) (sup_any_dead rest) true)

sup_respawn_all h nil = nil
sup_respawn_all h (cons c rest) =
  (cons (pair (spawn h (snd c)) (snd c)) (sup_respawn_all h rest))

sup_restart_all h c =
  (if (sup_any_dead c)
    (sup_respawn_all h c)
    c)

sup_restart_rest_aux h nil 0 = nil
sup_restart_rest_aux h nil 1 = nil
sup_restart_rest_aux h (cons c rest) 0 =
  (if (is_alive (fst c))
    (cons c (sup_restart_rest_aux h rest 0))
    (cons (pair (spawn h (snd c)) (snd c)) (sup_restart_rest_aux h rest 1)))
sup_restart_rest_aux h (cons c rest) 1 =
  (cons (pair (spawn h (snd c)) (snd c)) (sup_restart_rest_aux h rest 1))

sup_restart_rest h c = (sup_restart_rest_aux h c 0)

sup_tick_fn_with state =
  (pair (fst state)
        (pair (fst (snd state))
              ((fst state) (fst (snd state)) (snd (snd state)))))

sup_spawn_with strat h inits =
  (gen_server_spawn (pair strat (pair h (sup_make h inits))))

sup_tick_with sup =
  (let many _ = (gen_server_cast sup sup_tick_fn_with) in
   (run sup))

sup_children_with s = (snd (snd s))
sup_count_with s = (sup_count_alive (sup_children_with s))
sup_p1 s = (fst (head (sup_children_with s)))
sup_p2 s = (fst (head (tail (sup_children_with s))))
sup_p3 s = (fst (head (tail (tail (sup_children_with s)))))

-- ═══ O2.4 : event-driven (link + trap_exit) ═══

link_all sup nil = 0
link_all sup (cons c rest) =
  (let many _ = (link sup (fst c)) in
   (link_all sup rest))

set_sup_pid state sup =
  (pair (fst state) (pair (fst (snd state)) (pair sup (snd (snd (snd state))))))

restart_state_v2 state =
  (let many strat = (fst state) in
   (let many h = (fst (snd state)) in
    (let many sup = (fst (snd (snd state))) in
     (let many children = (snd (snd (snd state))) in
      (let many new_children = (strat h children) in
       (let many _ = (link_all sup new_children) in
        (pair strat (pair h (pair sup new_children)))))))))

sup_step_v2 state msg =
  (if (is_str msg)
    (restart_state_v2 state)
    (msg state))

sup_spawn_v2 strat h inits =
  (let many children = (sup_make h inits) in
   (let many sup = (spawn sup_step_v2 (pair strat (pair h (pair 0 children)))) in
    (let many _ = (tell sup (lambda state -> (set_sup_pid state sup))) in
     (let many _ = (link_all sup children) in
      (let many _ = (trap_exit sup true) in
       sup)))))

sup_drain sup = (run sup)

sup_children_v2 s = (snd (snd (snd s)))
sup_count_v2 s = (sup_count_alive (sup_children_v2 s))
sup_p1_v2 s = (fst (head (sup_children_v2 s)))
sup_p2_v2 s = (fst (head (tail (sup_children_v2 s))))
