-- core/std/recursion.hvn (pilote Kmett-style v0)
-- Schemas de recursion sur List. Sucre pur, aucune magic nouvelle.

module Recursion

-- ─── cata : consommer une structure ───
-- cata f z [x1, x2, ..., xn] = f x1 (f x2 (... (f xn z)))
-- C'est foldr, mais le nom "cata" souligne qu'on reconstruit
-- la structure avec f a la place de cons et z a la place de nil.
cata _ z nil = z
cata f z (cons x xs) = f x (cata f z xs)

-- ─── ana : generer une structure ───
-- f : seed -> Option (value, next_seed)
-- ana f s genere [v1, v2, ...] en iterant tant que f retourne some.
-- S'arrete au premier none.
ana f seed = ana_step f (f seed)

ana_step _ none = nil
ana_step f (some (pair x next)) = cons x (ana f next)

-- ─── hylo : ana puis cata ───
-- Consommer immediatement ce qu'on vient de generer.
-- En theorie on peut fusionner (deforestation) ; v0 compose.
hylo g z f seed = cata g z (ana f seed)

-- ─── para : cata avec acces a la sous-structure ───
-- para f z [x1, ..., xn] = f x1 [x2,...,xn] (f x2 [x3,...,xn] (...))
-- Utile quand on a besoin de la queue elle-meme, pas seulement
-- du resultat de sa consommation (ex: dropWhile, splitAt).
para _ z nil = z
para f z (cons x xs) = f x xs (para f z xs)
