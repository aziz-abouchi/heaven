module List

data List a = nil | cons a (List a)

head (cons x _) = x
tail (cons _ xs) = xs

length nil = zero
length (cons _ xs) = succ (length xs)

null nil = true
null (cons _ _) = false

-- ─── Egalite avec la liste vide ───
-- isEmpty xs : alias lisible pour null.
isEmpty xs = (null xs)

-- ─── Singleton ───
-- singleton x = [x] (liste a un element).
singleton x = (cons x nil)

-- ─── Dernier element ───
-- last xs : le dernier element. Pas de clause pour nil
-- (comme head).
last (cons x nil) = x
last (cons _ xs) = (last xs)

-- ─── Tout sauf le dernier ───
-- init xs : la liste privee de son dernier element.
-- Pas de clause pour nil (comme tail).
init (cons _ nil) = nil
init (cons x xs) = (cons x (init xs))

-- ─── Decomposer tete + queue ───
-- uncons xs : Some (Pair x xs) si non vide, None sinon.
uncons nil = none
uncons (cons x xs) = (some (pair x xs))

append nil ys = ys
append (cons x xs) ys = cons x (append xs ys)

concat nil ys = ys
concat (cons x xs) ys = cons x (concat xs ys)

map _ nil = nil
map f (cons x xs) = cons (f x) (map f xs)

reverse xs = rev_helper xs nil
rev_helper nil acc = acc
rev_helper (cons x xs) acc = rev_helper xs (cons x acc)

filter _ nil = nil
filter f (cons x xs) = if (f x) (cons x (filter f xs)) (filter f xs)

foldl _ acc nil = acc
foldl f acc (cons x xs) = foldl f (f acc x) xs

foldr _ acc nil = acc
foldr f acc (cons x xs) = f x (foldr f acc xs)

take _ nil = nil
take (succ n) (cons x xs) = cons x (take n xs)
take zero _ = nil

drop _ nil = nil
drop zero xs = xs
drop (succ n) (cons _ xs) = drop n xs

-- ─── Prise / rejet avec predicat ───
-- takeWhile p xs : prend tant que (p x) est vrai.
takeWhile _ nil = nil
takeWhile p (cons x xs) = (if (p x) (cons x (takeWhile p xs)) nil)

-- dropWhile p xs : jette tant que (p x) est vrai.
dropWhile _ nil = nil
dropWhile p (cons x xs) = (if (p x) (dropWhile p xs) (cons x xs))

-- ─── Decoupe a une position ───
-- splitAt n xs : Pair (List a, List a) -- les n premiers, le reste.
splitAt zero xs = (pair nil xs)
splitAt _ nil = (pair nil nil)
splitAt (succ n) (cons x xs) = (splitAt_cons n x xs)

splitAt_cons n x xs =
  let rest = (splitAt n xs) in
  (pair (cons x (fst rest)) (snd rest))

-- ─── Recherche ───
-- find p xs : Some x du premier x ou (p x) est vrai, None sinon.
find _ nil = none
find p (cons x xs) = (if (p x) (some x) (find p xs))

-- any p xs : vrai si au moins un element satisfait p.
any _ nil = false
any p (cons x xs) = (if (p x) true (any p xs))

elem _ nil = false
elem x (cons y ys) = if (= x y) true (elem x ys)
