module List

data List a = nil | cons a (List a)

head (cons x _) = x
tail (cons _ xs) = xs

length nil = zero
length (cons _ xs) = succ (length xs)

null nil = true
null (cons _ _) = false

-- ─── Egalite avec la liste vide ───
-- isEmpty xs : alias lisible pour null.
isEmpty xs = (null xs)

-- ─── Singleton ───
-- singleton x = [x] (liste a un element).
singleton x = (cons x nil)

-- ─── Dernier element ───
-- last xs : le dernier element. Pas de clause pour nil
-- (comme head).
last (cons x nil) = x
last (cons _ xs) = (last xs)

-- ─── Tout sauf le dernier ───
-- init xs : la liste privee de son dernier element.
-- Pas de clause pour nil (comme tail).
init (cons _ nil) = nil
init (cons x xs) = (cons x (init xs))

-- ─── Decomposer tete + queue ───
-- uncons xs : Some (Pair x xs) si non vide, None sinon.
uncons nil = none
uncons (cons x xs) = (some (pair x xs))

append nil ys = ys
append (cons x xs) ys = cons x (append xs ys)

concat nil ys = ys
concat (cons x xs) ys = cons x (concat xs ys)

map _ nil = nil
map f (cons x xs) = cons (f x) (map f xs)

reverse xs = rev_helper xs nil
rev_helper nil acc = acc
rev_helper (cons x xs) acc = rev_helper xs (cons x acc)

filter _ nil = nil
filter f (cons x xs) = if (f x) (cons x (filter f xs)) (filter f xs)

foldl _ acc nil = acc
foldl f acc (cons x xs) = foldl f (f acc x) xs

foldr _ acc nil = acc
foldr f acc (cons x xs) = f x (foldr f acc xs)

take _ nil = nil
take (succ n) (cons x xs) = cons x (take n xs)
take zero _ = nil

drop _ nil = nil
drop zero xs = xs
drop (succ n) (cons _ xs) = drop n xs

elem _ nil = false
elem x (cons y ys) = if (= x y) true (elem x ys)
