-- Kernel Heaven v0.1 — Noyau logique minimal
-- Types de base
data Term = Lit Int | Var String | Apply String List<Term>
data Type = Prop | Nat | Arrow Type Type
data Proof
    = Refl Term
    | Sym Proof
    | Trans Proof Proof
    | Cong String Proof
    | ByEval Term Term
    | ByRewrite String Term Term
    | ByInduction String Proof Proof

-- Jugements
axiom refl      : forall (a : Term). Eq<a,a>
axiom sym       : forall (a b : Term). Eq<a,b> -> Eq<b,a>
axiom trans     : forall (a b c : Term). Eq<a,b> -> Eq<b,c> -> Eq<a,c>
axiom cong      : forall (f : String) (a b : Term). Eq<a,b> -> Eq<Apply<f,a>,Apply<f,b>>

-- Arithmétique de base
axiom add_zero  : forall (n : Nat). Eq<Add<n,Zero>, n>
axiom add_succ  : forall (n m : Nat). Eq<Add<n,Succ<m>>, Succ<Add<n,m>>>
axiom mul_zero  : forall (n : Nat). Eq<Mul<n,Zero>, Zero>
axiom mul_succ  : forall (n m : Nat). Eq<Mul<n,Succ<m>>, Add<Mul<n,m>,n>>
