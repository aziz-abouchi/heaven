# ═══════════════════════════════════════════════════
# Section 8 — Bindings Core (regression suite pour bindSym/bindSymWithBody)
# ═══════════════════════════════════════════════════

# Cas nominal : la valeur est capturée, le corps est évalué.
test "let_bind_basic": (let linear x = 5 in (+ x 1)) == 6

# Forme identité : le corps est juste la variable.
test "let_bind_identity": (let linear x = 42 in x) == 42

# linear + shadowing : la variable externe est masquée (0 usage) → violation.
test "let_bind_shadowing_linear_rejected": assert_err (let linear x = 1 in (let linear x = 2 in x))

# many + shadowing : aucune contrainte de multiplicité → autorisé.
test "let_bind_shadowing_many_ok": (let many x = 1 in (let many x = 2 in x)) == 2

# Deux variables distinctes dans le même scope.
test "let_bind_two_vars": (let linear x = 3 in (let linear y = 4 in (+ x y))) == 7

# Si ce test passe, A est appliqué : .bind est bien produit par le parser.
# Si ça casse, A n'est pas appliqué (retour à apply(sym"let") silencieux).
test "bind_core_probe": (let linear x = 7 in (+ x 0)) == 7

# ═══════════════════════════════════════════════════
# Section 9 — Chaînes de preuve (regression suite pour appendStream)
# ═══════════════════════════════════════════════════

# Un théorème simple qui passe par une seule étape.
theorem t_identity : x + 0 = x
prove t_identity by simplify

# Une chaîne de deux théorèmes : le second dépend du premier.
# Si appendStream perd des substitutions, la 2e étape ne verra pas
# la conclusion de la 1re.
theorem t_double_zero : (x + 0) + 0 = x
prove t_double_zero by simplify

# Un théorème dont la preuve nécessite plusieurs réécritures
# (donc plusieurs substitutions produites et concaténées).
theorem t_distrib : (2 * x) + (2 * y) = 2 * (x + y)
prove t_distrib by simplify

test "type_lambda_identity": type (λx.x) == "_t0 -> _t0"
test "type_lambda_applied": type ((λx.x) 42) == "Int"