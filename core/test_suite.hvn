# ═══════════════════════════════════════════════════
# Heaven Native Test Suite (Framework natif)
# ═══════════════════════════════════════════════════

# --- 1. Arithmétique & CAS ---
test "addition": (+ 1 2) == 3
test "multiplication": (* 3 4) == 12
test "derive_x2": derive x^2 == (* 2 x)
test "simplify_0_add": simplify (+ x (+ 0 x)) == (* 2 x)
test "distributivity": simplify (* 2 (+ x 3)) == (+ (* 2 x) 6)
test "factorization": simplify (+ (* 3 x) (* 3 y)) == (* 3 (+ x y))
test "factor_common_left":  simplify (+ (* 3 x) (* 3 y)) == (* 3 (+ x y))
test "factor_common_right": simplify (+ (* x 3) (* y 3)) == (* 3 (+ x y))
test "factor_common_mix":   simplify (+ (* 3 x) (* y 3)) == (* 3 (+ x y))

# --- 2. Macros Hygiéniques ---
let macro double(x) = (quote (* (unquote x) 2))
test "macro_double": (double 21) == 42

# --- 3. Acteurs Typés ---
fn counterHandler(state, msg) = (+ state msg)
let actor Counter = 0 with counterHandler
send(Counter, 10)
send(Counter, 5)
test "actor_state": state(Counter) == 15


# --- 4. Effets Algébriques ---
fn logHandler msg = (+ msg 100)
test "effect_handle": handle (perform "Log" 42) logHandler == 142

# --- 5. Commandes Shell (hors framework natif car elles retournent des chaînes) ---
simplify (+ x (+ 0 x))
derive x^2
type (+ 1 x)
green (+ 1 (* 2 3))
green (handle (perform "Log" 42) logHandler)
theorem add_zero : x + 0 = x
prove add_zero by simplify

# --- 6. Tests d'Erreurs (Robustesse) ---
test "div_by_zero": assert_err (/ 5 0)
test "actor_not_found": assert_err (send 999 5)
test "type_mismatch": assert_err (+ 1 true)

# --- 7. Tests de simplification et dérivation améliorés ---
test "simplify_double":     simplify (+ x x) == (* 2 x)
test "simplify_egraph_double": simplify (+ x (+ 0 x)) == (* 2 x)
test "simplify_add_zero":   simplify (+ x 0) == x
test "simplify_mul_one":    simplify (* x 1) == x
test "simplify_mul_zero":   simplify (* x 0) == 0
test "simplify_double_add": simplify (+ (+ x 0) 0) == x
test "simplify_double_mul": simplify (* (* x 1) 1) == x

test "derive_power2": derive x^2 == (* 2 x)
test "derive_power3": derive x^3 == (* 3 (^ x 2))
test "square_detection": simplify (* x x) == (^ x 2)

(assert_err (let-linear x 5 (+ x x)))
(assert_err (let-linear x 5 42))
(assert_eq (let-linear x 5 (+ x 1)) 6)
(assert_err (let-erased x 5 (+ x 1)))
(assert_eq (let-erased x 5 42) 42)
(assert_eq (let-many x 5 (+ x x)) 10)

(assert_err (let linear x = 5 in (+ x x)))
(assert_err (let linear x = 5 in 42))
(assert_eq (let linear x = 5 in (+ x 1)) 6)
(assert_err (let erased x = 5 in (+ x 1)))
(assert_eq (let erased x = 5 in 42) 42)
(assert_eq (let many x = 5 in (+ x x)) 10)

assert_eq (+ 1 2) == 3
assert_err (/ 5 0)

let test_env_var := 42
assert_eq test_env_var == 42

let typed_var:Int = 42
assert_eq typed_var == 42


# ── Portage des ex-tests web-only (test_heaven.js) ──
test "infix_add": 2 + 3 == 5
test "infix_precedence": 2 * 3 + 1 == 7
test "infix_div": 10 / 2 == 5
test "if_true": (if (> 3 2) 1 0) == 1
test "if_false": (if (< 2 1) 10 20) == 20
double x = x * 2
test "fn_infix_body": (double 21) == 42
triple x := x * 3
test "fn_walrus_body": (triple 21) == 63
test "derive_poly": derive x^2 + 2*x + 1 == (+ (* 2 x) 2)

# Fumigue (neutral, sortie non canonique — attrape les crashes, pas les valeurs)
type (λx.x)
type ((λx.x) 42)
latex (x + y)^2
integrate 2*x

