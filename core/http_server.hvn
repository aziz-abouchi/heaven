-- MARKER-XYZZY-42
-- core/http_server.hvn — Serveur HTTP simplifié et robuste
import "stdlib/net/http.hvn"
import "stdlib/net/tcp.hvn"
import "stdlib/string.hvn"
import "stdlib/fs.hvn"

-- Note : on evite `if COND (let ...) (let ...)` (bug parser
-- if-multiligne-let-in). Chaque branche est une fonction a part.
handle_request req =
  let p = (req_path req) in
  let is_api = (string_eq p "/api/egraph") in
  (if is_api (handle_api p) (handle_static p))

handle_api _ =
  let cap = (cap_acquire "egraph:snapshot") in
  let json = (@egraph_snapshot cap) in
  (pair 200 (pair json nil))

handle_static p =
  let path = (if (string_eq p "/") "index.html" p) in
  let body = (fs_read_public path) in
  (pair 200 (pair body nil))

-- En V0, @spawn est un dummy (retourne un id sans executer le
-- thunk). On traite donc le client sequentiellement, un a la fois.
-- C'est suffisant pour servir les fichiers statiques.
handle_client cap listen_fd =
  let client_fd = (net_accept cap listen_fd) in
  (handle_one_client cap client_fd)

handle_one_client cap client_fd =
  let raw = (net_read cap client_fd) in
  let req = (parse_request raw) in
  let resp = (handle_request req) in
  let _ = (net_write cap client_fd (format_response resp)) in
  (net_close cap client_fd)

server_loop cap listen_fd =
  let _ = (handle_client cap listen_fd) in
  (server_loop cap listen_fd)

http_serve port =
  let cap = (cap_acquire (string_concat "net:listen:" (int_to_string port))) in
  let listen_fd = (net_listen cap port) in
  let _ = (print (string_concat "🌌 Heaven HTTP on http://127.0.0.1:" (int_to_string port))) in
  (server_loop cap listen_fd)
