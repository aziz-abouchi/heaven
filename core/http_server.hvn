-- MARKER-XYZZY-42
-- core/http_server.hvn — Serveur HTTP simplifié et robuste
import "stdlib/net/http.hvn"
import "stdlib/net/tcp.hvn"
import "stdlib/string.hvn"
import "stdlib/fs.hvn"

-- Note : on evite `if COND (let ...) (let ...)` (bug parser
-- if-multiligne-let-in). Chaque branche est une fonction a part.
-- Routing (2026-10-27, E4-D2bis) : fullstack Heaven natif,
-- remplace Vessel. Sert REPL, IDE, TESTS, DOCS + assets (JS/CSS/WASM).
-- Note : on garde les URLs explicites avec extension (.html) pour
-- eviter la resolution d'extension (pas de string_index_of fiable).

content_type path = (if (string_ends_with path ".wasm") "application/wasm" (if (string_ends_with path ".js") "application/javascript" (if (string_ends_with path ".css") "text/css" (if (string_ends_with path ".json") "application/json" "text/html"))))

strip_slash p =
  (if (string_starts_with p "/")
    (string_substring p 1 (- (string_length p) 1))
    p)

-- ── Pages Hab : littéraux bruts (aucun guillemet interne → pas d'escape)
h_ide_page unit =
  "<html><head><meta charset=utf-8><title>Heaven IDE</title><link rel=stylesheet href=/common.css></head><body><h1>HEAVEN IDE (Hab)</h1><iframe src=/editor-frame.html class=full></iframe></body></html>"

h_repl_page unit =
  "<html><head><meta charset=utf-8><title>Heaven REPL</title><link rel=stylesheet href=/common.css></head><body><h1>HEAVEN REPL (Hab)</h1><iframe src=/repl-frame.html class=full></iframe></body></html>"

h_dashboard_page unit =
  "<html><head><meta charset=utf-8><title>Heaven Dashboard</title><link rel=stylesheet href=/common.css></head><body><h1>HEAVEN DASHBOARD (Hab)</h1><iframe src=/process-frame.html class=full></iframe></body></html>"

h_docs_page unit =
  "<html><head><meta charset=utf-8><title>Heaven Docs</title><link rel=stylesheet href=/common.css></head><body><h1>HEAVEN DOCS (Hab)</h1><p>Hab-rendered documentation</p></body></html>"

h_index_page unit =
  "<html><head><meta charset=utf-8><title>Heaven Vision</title><link rel=stylesheet href=/common.css></head><body><h1>HEAVEN VISION (Hab)</h1><ul><li><a href=/hab/ide>IDE</a></li><li><a href=/hab/repl>REPL</a></li><li><a href=/hab/dashboard>Dashboard</a></li><li><a href=/hab/docs>Docs</a></li></ul></body></html>"

h_ok html = (pair 200 (pair "text/html; charset=utf-8" (pair html nil)))
h_404 unit = (pair 404 (pair "text/plain" (pair "not found" nil)))

handle_hab p =
  let clean = (strip_query p) in
  (if (clean == "/hab/ide") (h_ok (h_ide_page unit))
    (if (clean == "/hab/repl") (h_ok (h_repl_page unit))
      (if (clean == "/hab/dashboard") (h_ok (h_dashboard_page unit))
        (if (clean == "/hab/docs") (h_ok (h_docs_page unit))
          (if (clean == "/hab/") (h_ok (h_index_page unit))
            (h_404 unit))))))

handle_request req =
  let p = (req_path req) in
  let is_api = (p == "/api/egraph") in
  let is_hab = (string_starts_with p "/hab/") in
  (if is_api (handle_api p)
    (if is_hab (handle_hab p)
      (handle_static p)))

handle_api _ =
  let cap = (cap_acquire "egraph:snapshot") in
  let json = (@egraph_snapshot cap) in
  (pair 200 (pair "application/json" (pair json nil)))

-- 2026-10-28 : strip query string (?t=123, ?foo=bar). Un serveur
-- HTTP doit ignorer le query pour le routing FS. Sinon cache-busters
-- (?t=Date.now() de hab_runtime.js) cassent tout — le serveur sert
-- 200 avec "ERROR: File not found" au lieu du fichier.
-- Code byte 63 = '?'. string_index_of retourne -1 si absent.
strip_query s =
  let i = (string_index_of s 63) in
  (if (< i 0) s (string_substring s 0 i))

handle_static p =
  let clean_path = (strip_query p) in
  let path0 = (if (clean_path == "/") "index.html" clean_path) in
  let path_raw = (strip_slash path0) in
  let path = (if (== path_raw "") "index.html" path_raw) in
  let ctype = (content_type path) in
  let body = (fs_read_public path) in
  (pair 200 (pair ctype (pair body nil)))

-- En V0, @spawn est un dummy (retourne un id sans executer le
-- thunk). On traite donc le client sequentiellement, un a la fois.
-- C'est suffisant pour servir les fichiers statiques.
handle_client cap listen_fd =
  let client_fd = (net_accept cap listen_fd) in
  (if (>= client_fd 0) (handle_one_client cap client_fd) unit)

handle_one_client cap client_fd =
  let raw = (net_read cap client_fd) in
  let req = (parse_request raw) in
  let resp = (handle_request req) in
  let _ = (net_write cap client_fd (format_response_ct resp)) in
  let _ = (@clear_thunks) in
  (net_close cap client_fd)

-- 2026-10-28 (Phase 7) : self-call direct via seq. TCO marche pour
-- if + seq + block. `let` + self-call crashe (Phase 7b, dette).
-- Forme : (if @exiting unit (seq (handle_client ...) (server_loop ...))).
-- Le self-call est en queue du seq, collecte par collectTailSpine.
-- @loop_until n'est plus necessaire.
server_loop cap listen_fd =
  (if (@exiting) unit (seq (handle_client cap listen_fd) (server_loop cap listen_fd)))

hvn_http_serve_v2 port =
  let cap = (cap_acquire (string_concat "net:listen:" (int_to_string port))) in
  let listen_fd = (net_listen cap port) in
  let _ = (print (string_concat "🌌 Heaven HTTP on http://127.0.0.1:" (int_to_string port))) in
  (server_loop cap listen_fd)
