-- core/stream.hvn — Stream paresseux (D12)
-- Prefixe stream_ : evite les collisions avec take/map/filter stricts
-- de core/std/list.hvn (qui operent sur List).

data Stream a = Cons a (Stream a) | End

-- Generateurs (paresseux)
stream_nats_from n = Cons n (delay (stream_nats_from (+ n 1)))
-- NB : pas de CAF `stream_nats = ...` ; utiliser
-- directement (stream_nats_from 0). Une CAF non appliquee est
-- vue comme un symbole (fonction), pas comme une valeur.
stream_repeat x = Cons x (delay (stream_repeat x))
stream_iterate f x = Cons x (delay (stream_iterate f (f x)))

-- Mapping (paresseux)
stream_map f End = End
stream_map f (Cons x rest) = Cons (f x) (delay (stream_map f (force rest)))

-- Filtrage (paresseux)
stream_filter p End = End
stream_filter p (Cons x rest) = if (p x) (Cons x (delay (stream_filter p (force rest)))) (stream_filter p (force rest))

-- Take (arret a n=0)
stream_take_step n End = End
stream_take_step n (Cons x rest) = Cons x (stream_take_impl (- n 1) (force rest))
stream_take_impl n s = if (= n 0) End (stream_take_step n s)
stream_take n s = stream_take_impl n s

-- Drop
stream_drop zero s = s
stream_drop n End = End
stream_drop n (Cons x rest) = stream_drop (- n 1) (force rest)

-- Utilitaires
stream_sum End = 0
stream_sum (Cons x rest) = (+ x (stream_sum (force rest)))

stream_nth n End = 0
stream_nth n (Cons x rest) = (if (= n 0) x (stream_nth (- n 1) (force rest)))

-- Longueur d'un stream (fini).
stream_length End = 0
stream_length (Cons x rest) = (+ 1 (stream_length (force rest)))
