-- ═══ Stream (paresseux, D12) ═══
-- Convention : la queue d'un Cons peut etre un thunk (delay ...).
-- Les fonctions ci-dessous forcent la queue via `force` avant recurser ;
-- `force` est identite sur un non-thunk, donc les streams finis
-- construits directement (Cons x End) marchent aussi.

data Stream a = Cons a (Stream a) | End

-- ═══ Pair ═══
data Pair a b = Pair a b

-- ═══ Generation paresseuse ═══
nats_from n = Cons n (delay (nats_from (+ n 1)))
nats = nats_from 0
repeat x = Cons x (delay (repeat x))
iterate f x = Cons x (delay (iterate f (f x)))

-- ═══ map ═══
map f End = End
map f (Cons x rest) = Cons (f x) (delay (map f (force rest)))

-- ═══ filter ═══
filter p End = End
filter p (Cons x rest) =
  if (p x)
    (Cons x (delay (filter p (force rest))))
    (filter p (force rest))

-- ═══ take ═══
take zero s = End
take (succ n) End = End
take (succ n) (Cons x rest) = Cons x (take n (force rest))

-- ═══ drop ═══
drop zero s = s
drop (succ n) End = End
drop (succ n) (Cons x rest) = drop n (force rest)

-- ═══ zip ═══
zip End s = End
zip s End = End
zip (Cons x rx) (Cons y ry) = Cons (Pair x y) (delay (zip (force rx) (force ry)))

-- ═══ tap ═══
tap g End = End
tap g (Cons x rest) = Cons x (delay (tap g (force rest)))

-- ═══ Utilitaires de test ═══
nth zero (Cons x rest) = x
nth (succ n) (Cons x rest) = nth n (force rest)
nth n End = 0

ssum End = 0
ssum (Cons x rest) = (+ x (ssum (force rest)))
