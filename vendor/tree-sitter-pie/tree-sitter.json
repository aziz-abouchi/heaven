{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pie",
      "camelcase": "Pie",
      "title": "Pie",
      "scope": "source.pie",
      "file-types": [
        "pie"
      ],
      "injection-regex": "^pie$",
      "class-name": "TreeSitterPie"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Pie grammar for tree-sitter",
    "authors": [
      {
        "name": "I don't know"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-pie"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}