const std = @import("std");

pub const NodeKind = enum {
    Function,
    Call,
    Return,
    BinOp,
    If,
    Loop,
    VarDecl,
    Assign,
    LiteralInt,
    LiteralFloat,
    LiteralString,
    LiteralBool,
    Identifier,
    TypeName,
    StructDecl,
    EnumDecl,
    ImplBlock,
    FactDecl,
    RuleDecl,
    QueryExpr,
    ActorDecl,
    SpawnExpr,
    SendExpr,
    MatchExpr,
    Lambda,
    PipeExpr,
    RangeExpr,
    EffectDecl,
    HandleExpr,
    FieldAccess,
    IndexExpr,
    Block,
    Unknown,
};

pub fn classifyNode(ntype: []const u8) NodeKind {
    if (eqAny(ntype, &.{ "fndecl", "distfn", "functiondeclaration", "functiondefinition", "fn_proto" })) return .Function;
    if (eqAny(ntype, &.{ "call", "call_expression" })) return .Call;
    if (eqAny(ntype, &.{ "ret", "returnstatement", "returnexpression" })) return .Return;
    if (eqAny(ntype, &.{ "binary", "binary_expression" })) return .BinOp;
    if (eqAny(ntype, &.{ "ifstmt", "ifexpr", "ifstatement", "ifexpression" })) return .If;
    if (eqAny(ntype, &.{ "whilestmt", "forstmt", "loopstmt", "whilestatement", "for_statement" })) return .Loop;
    if (eqAny(ntype, &.{ "vardecl", "declaration", "variabledeclaration" })) return .VarDecl;
    if (eqAny(ntype, &.{ "assign", "assignmentexpression", "assignmentstatement" })) return .Assign;
    if (eqAny(ntype, &.{ "structdecl", "structspecifier", "container_declaration" })) return .StructDecl;
    if (eqAny(ntype, &.{ "enumdecl", "enumspecifier" })) return .EnumDecl;
    if (std.mem.eql(u8, ntype, "impl_block")) return .ImplBlock;
    if (std.mem.eql(u8, ntype, "fact_decl")) return .FactDecl;
    if (std.mem.eql(u8, ntype, "rule_decl")) return .RuleDecl;
    if (std.mem.eql(u8, ntype, "query_expr")) return .QueryExpr;
    if (std.mem.eql(u8, ntype, "actor_decl")) return .ActorDecl;
    if (std.mem.eql(u8, ntype, "spawn")) return .SpawnExpr;
    if (std.mem.eql(u8, ntype, "send")) return .SendExpr;
    if (eqAny(ntype, &.{ "matchstmt", "matchexpr", "switch_statement" })) return .MatchExpr;
    if (eqAny(ntype, &.{ "lambda", "arrow_function" })) return .Lambda;
    if (std.mem.eql(u8, ntype, "pipe")) return .PipeExpr;
    if (std.mem.eql(u8, ntype, "range")) return .RangeExpr;
    if (std.mem.eql(u8, ntype, "effect_decl")) return .EffectDecl;
    if (std.mem.eql(u8, ntype, "handle_expr")) return .HandleExpr;
    if (eqAny(ntype, &.{ "member", "fieldexpression", "fieldaccess" })) return .FieldAccess;
    if (eqAny(ntype, &.{ "index", "subscript_expression" })) return .IndexExpr;
    if (eqAny(ntype, &.{ "block", "compound_statement" })) return .Block;
    if (eqAny(ntype, &.{ "int", "numberliteral", "integerliteral" })) return .LiteralInt;
    if (eqAny(ntype, &.{ "float", "float_literal" })) return .LiteralFloat;
    if (eqAny(ntype, &.{ "str", "string_literal", "string" })) return .LiteralString;
    if (eqAny(ntype, &.{ "bool_lit", "true", "false" })) return .LiteralBool;
    if (std.mem.eql(u8, ntype, "identifier")) return .Identifier;
    if (std.mem.eql(u8, ntype, "type_name")) return .TypeName;
    return .Unknown;
}

fn eqAny(s: []const u8, list: []const []const u8) bool {
    for (list) |item| {
        if (std.mem.eql(u8, s, item)) return true;
    }
    return false;
}
