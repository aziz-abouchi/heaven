const std = @import("std");
const matrix_lib = @import("../core/matrix.zig");

pub const CCodegen = struct {
    matrix: *matrix_lib.Matrix,
    allocator: std.mem.Allocator,
    output: std.ArrayListUnmanaged(u8),

    pub fn init(alloc: std.mem.Allocator, matrix: *matrix_lib.Matrix) CCodegen {
        return .{
            .matrix = matrix,
            .allocator = alloc,
            .output = .{},
        };
    }

    pub fn deinit(self: *CCodegen) void {
        self.output.deinit(self.allocator);
    }

    pub fn generate(self: *CCodegen) ![]const u8 {
        try self.emit("#include <stdint.h>\n");
        try self.emit("#include <stdio.h>\n");
        try self.emit("#include <stdlib.h>\n\n");
        try self.emit("// Generated by Heaven Compiler\n\n");

        // Collecter TOUTES les fonctions avec leur arité correcte
        var func_info = std.StringHashMap(usize).init(self.allocator);
        defer func_info.deinit();

        var it = self.matrix.nodes.iterator();
        while (it.next()) |entry| {
            switch (entry.value_ptr.*) {
                .HFunc => |func| {
                    const name = self.getSymbolName(func.name) orelse continue;
                    if (self.isInternalName(name)) continue;

                    // Prendre l'arité du var_clause (sans literal), sinon la première
                    const existing = func_info.get(name);
                    if (existing == null) {
                        func_info.put(name, func.params.len) catch {};
                    } else if (!self.hasLiteralParam(func.params)) {
                        // Préférer l'arité du catch-all
                        func_info.put(name, func.params.len) catch {};
                    }
                },
                else => {},
            }
        }

        // Forward declarations basées sur l'arité correcte
        try self.emit("// Forward declarations\n");
        var fi = func_info.iterator();
        while (fi.next()) |entry| {
            try self.emitFmt("int64_t heaven_{s}(", .{entry.key_ptr.*});
            var pi: usize = 0;
            while (pi < entry.value_ptr.*) : (pi += 1) {
                if (pi > 0) try self.emit(", ");
                try self.emit("int64_t");
            }
            try self.emit(");\n");
        }
        try self.emit("\n");

        // Définitions
        var fi2 = func_info.iterator();
        while (fi2.next()) |entry| {
            try self.emitFunctionByName(entry.key_ptr.*);
        }

        try self.emit("\n// Entry point\n");
        try self.emitMain();

        return self.output.items;
    }

    pub fn generateForFunction(self: *CCodegen, fname: []const u8) ![]const u8 {
        // Header minimal
        try self.emit("#include <stdint.h>\n");
        try self.emit("#include <stdio.h>\n");
        try self.emit("#include <stdlib.h>\n\n");

        // Trouver toutes les dépendances
        var deps = std.StringHashMap(bool).init(self.allocator);
        defer deps.deinit();
        try self.collectDeps(fname, &deps);

        // Émettre les fonctions dépendantes + la cible
        var dep_it = deps.iterator();
        while (dep_it.next()) |entry| {
            try self.emitFunctionByName(entry.key_ptr.*);
        }
        try self.emitFunctionByName(fname);

        // Main qui appelle la fonction
        try self.emit("\nint main(int argc, char** argv) {\n");
        try self.emit("    if (argc < 2) { printf(\"Usage: %s <arg>\\n\", argv[0]); return 1; }\n");
        try self.emit("    int64_t n = atoll(argv[1]);\n");
        try self.emitFmt("    printf(\"%lld\\n\", heaven_{s}(n));\n", .{fname});
        try self.emit("    return 0;\n}\n");

        return self.output.items;
    }

    // ═══════════════════════════════════════════════════════════
    //  ÉMISSION
    // ═══════════════════════════════════════════════════════════

    fn emitForwardDecls(self: *CCodegen) !void {
        var max_arity = std.StringHashMap(usize).init(self.allocator);
        defer max_arity.deinit();

        var it = self.matrix.nodes.iterator();
        while (it.next()) |entry| {
            switch (entry.value_ptr.*) {
                .HFunc => |func| {
                    const name = self.getSymbolName(func.name) orelse continue;
                    if (self.isInternalName(name)) continue;
                    const existing = max_arity.get(name) orelse 0;
                    if (func.params.len > existing) {
                        max_arity.put(name, func.params.len) catch {};
                    }
                },
                else => {},
            }
        }

        var decl_it = max_arity.iterator();
        while (decl_it.next()) |entry| {
            try self.emitFmt("int64_t heaven_{s}(", .{entry.key_ptr.*});
            var pi: usize = 0;
            while (pi < entry.value_ptr.*) : (pi += 1) {
                if (pi > 0) try self.emit(", ");
                try self.emit("int64_t");
            }
            try self.emit(");\n");
        }
    }

    fn emitFunctions(self: *CCodegen) !void {
        // Collecter les fonctions par nom (grouper les clauses)
        var func_names = std.StringHashMap(bool).init(self.allocator);
        defer func_names.deinit();

        var it = self.matrix.nodes.iterator();
        while (it.next()) |entry| {
            switch (entry.value_ptr.*) {
                .HFunc => |func| {
                    const name = self.getSymbolName(func.name) orelse continue;
                    if (self.isInternalName(name)) continue;
                    func_names.put(name, true) catch {};
                },
                else => {},
            }
        }

        var names_it = func_names.iterator();
        while (names_it.next()) |entry| {
            try self.emitFunctionByName(entry.key_ptr.*);
        }
    }

    fn emitFunctionByName(self: *CCodegen, fname: []const u8) !void {
        const Clause = struct { params: []const matrix_lib.BobId, body: matrix_lib.BobId };
        var lit_clauses = std.ArrayListUnmanaged(Clause){};
        defer lit_clauses.deinit(self.allocator);
        var var_clause: ?Clause = null;
        var arity: usize = 0;

        var it = self.matrix.nodes.iterator();
        while (it.next()) |entry| {
            switch (entry.value_ptr.*) {
                .HFunc => |func| {
                    const name = self.getSymbolName(func.name) orelse continue;
                    if (std.mem.eql(u8, name, fname)) {
                        if (self.hasLiteralParam(func.params)) {
                            lit_clauses.append(self.allocator, .{ .params = func.params, .body = func.body }) catch {};
                        } else {
                            var_clause = .{ .params = func.params, .body = func.body };
                            arity = func.params.len; // Arité DEFINITIVE
                        }
                    }
                },
                else => {},
            }
        }

        // Si pas de var_clause, prendre la première clause comme référence d'arité
        if (var_clause == null and lit_clauses.items.len > 0) {
            arity = lit_clauses.items[0].params.len;
        }

        if (lit_clauses.items.len == 0 and var_clause == null) return;

        // Signature
        try self.emitFmt("int64_t heaven_{s}(", .{fname});
        var pi: usize = 0;
        while (pi < arity) : (pi += 1) {
            if (pi > 0) try self.emit(", ");
            try self.emitFmt("int64_t p{d}", .{pi});
        }
        try self.emit(") {\n");

        // Clauses littérales
        for (lit_clauses.items, 0..) |clause, ci| {
            if (ci == 0) try self.emit("    if (") else try self.emit("    } else if (");
            var first_cond = true;
            for (clause.params, 0..) |param_id, param_idx| {
                if (param_idx >= arity) break; // Ne pas dépasser l'arité
                const param_node = self.matrix.nodes.get(param_id) orelse continue;
                switch (param_node) {
                    .HIntLit => |n| {
                        if (!first_cond) try self.emit(" && ");
                        try self.emitFmt("p{d} == {d}", .{ param_idx, n });
                        first_cond = false;
                    },
        else => {},
        }
            }
    try self.emit(") {\n        return ");
    try self.emitExpr(clause.body, clause.params);
    try self.emit(";\n");
}

if (var_clause) |vc| {
    if (lit_clauses.items.len > 0) {
        try self.emit("    } else {\n");
    } else {
        try self.emit("    {\n");
    }
    try self.emit("        return ");
    try self.emitExpr(vc.body, vc.params);
    try self.emit(";\n");
}

try self.emit("    }\n}\n\n");
}

    fn hasLiteralParam(self: *CCodegen, params: []const matrix_lib.BobId) bool {
        for (params) |pid| {
            const node = self.matrix.nodes.get(pid) orelse continue;
            switch (node) {
                .HIntLit => return true,
                else => {},
            }
        }
        return false;
    }

    fn emitExpr(self: *CCodegen, node_id: matrix_lib.BobId, params: []const matrix_lib.BobId) !void {
        if (node_id == 0) {
            try self.emit("0");
            return;
        }
        const node = self.matrix.nodes.get(node_id) orelse {
            try self.emit("0");
            return;
        };

        switch (node) {
            .HIntLit => |n| {
                try self.emitFmt("{d}", .{n});
            },
            .Symbol => |name| {
                // Chercher dans les params
                for (params, 0..) |pid, idx| {
                    const pnode = self.matrix.nodes.get(pid) orelse continue;
                    switch (pnode) {
                        .Symbol => |pname| {
                            if (std.mem.eql(u8, pname, name)) {
                                try self.emitFmt("p{d}", .{idx});
                                return;
                            }
                        },
                        else => {},
                    }
                }
                // Variable non trouvée dans les params — peut être un appel sans args
                try self.emitFmt("heaven_{s}()", .{name});
            },
            .HBinOp => |op| {
                try self.emit("(");
                try self.emitExpr(op.left, params);
                try self.emit(switch (op.op) {
                    .Add => " + ",
                    .Sub => " - ",
                    .Mul => " * ",
                    .Div => " / ",
                    .Mod => " % ",
                    .Eq => " == ",
                    .Neq => " != ",
                    .Lt => " < ",
                    .Gt => " > ",
                    .Lte => " <= ",
                    .Gte => " >= ",
                    .And => " && ",
                    .Or => " || ",
                    else => " + ",
                });
                try self.emitExpr(op.right, params);
                try self.emit(")");
            },
            .HCall => |call| {
                const callee = self.matrix.nodes.get(call.callee) orelse {
                    try self.emit("0");
                    return;
                };
                const callee_name = switch (callee) {
                    .Symbol => |s| s,
                    else => "unknown",
                };
                try self.emitFmt("heaven_{s}(", .{callee_name});
                for (call.args, 0..) |aid, ai| {
                    if (ai > 0) try self.emit(", ");
                    try self.emitExpr(aid, params);
                }
                try self.emit(")");
            },
            else => {
                try self.emit("0 /* unsupported */");
            },
        }
    }

    fn emitMain(self: *CCodegen) !void {
        try self.emit("int main(int argc, char** argv) {\n");
        try self.emit("    if (argc < 2) {\n");
        try self.emit("        printf(\"Heaven compiled binary. Usage: %s <function> [args...]\\n\", argv[0]);\n");
        try self.emit("        return 0;\n");
        try self.emit("    }\n");
        try self.emit("    // TODO: dispatch par nom de fonction\n");
        try self.emit("    printf(\"Heaven compiled OK.\\n\");\n");
        try self.emit("    return 0;\n");
        try self.emit("}\n");
    }

    // ═══════════════════════════════════════════════════════════
    //  UTILITAIRES
    // ═══════════════════════════════════════════════════════════

    fn collectDeps(self: *CCodegen, fname: []const u8, deps: *std.StringHashMap(bool)) error{OutOfMemory}!void {
        var it = self.matrix.nodes.iterator();
        while (it.next()) |entry| {
            switch (entry.value_ptr.*) {
                .HFunc => |func| {
                    const name = self.getSymbolName(func.name) orelse continue;
                    if (std.mem.eql(u8, name, fname)) {
                        try self.collectExprDeps(func.body, deps, fname);
                    }
                },
                else => {},
            }
        }
    }

    fn collectExprDeps(self: *CCodegen, node_id: matrix_lib.BobId, deps: *std.StringHashMap(bool), exclude: []const u8) error{OutOfMemory}!void {
        if (node_id == 0) return;
        const node = self.matrix.nodes.get(node_id) orelse return;
        switch (node) {
            .HCall => |call| {
                const callee = self.matrix.nodes.get(call.callee) orelse return;
                switch (callee) {
                    .Symbol => |s| {
                        if (!std.mem.eql(u8, s, exclude)) {
                            deps.put(s, true) catch {};
                            // Recursive deps
                            try self.collectDeps(s, deps);
                        }
                    },
                    else => {},
                }
                for (call.args) |aid| {
                    try self.collectExprDeps(aid, deps, exclude);
                }
            },
            .HBinOp => |op| {
                try self.collectExprDeps(op.left, deps, exclude);
                try self.collectExprDeps(op.right, deps, exclude);
            },
            else => {},
        }
    }

    fn getSymbolName(self: *CCodegen, id: matrix_lib.BobId) ?[]const u8 {
        const node = self.matrix.nodes.get(id) orelse return null;
        return switch (node) {
            .Symbol => |s| s,
            else => null,
        };
    }

    fn isInternalName(_: *CCodegen, name: []const u8) bool {
        if (std.mem.startsWith(u8, name, "SIG:")) return true;
        if (std.mem.startsWith(u8, name, "FACT:")) return true;
        if (std.mem.startsWith(u8, name, "RULE:")) return true;
        return false;
    }

    fn emit(self: *CCodegen, text: []const u8) !void {
        try self.output.appendSlice(self.allocator, text);
    }

    fn emitFmt(self: *CCodegen, comptime fmt: []const u8, args: anytype) !void {
        var buf: [512]u8 = undefined;
        const text = std.fmt.bufPrint(&buf, fmt, args) catch return;
        try self.output.appendSlice(self.allocator, text);
    }
};
