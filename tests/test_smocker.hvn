-- tests/test_smocker.hvn (Smocker v1, DI)
import "core/std/smocker.hvn" as S

-- Fonction sous test : prend son effet en parametre
process http_get url = (http_get url)

-- Test : stub retourne une valeur fixe (arite 1)
test "smocker_fixed": (process (S.fixed "FAKE") "http://x") == "FAKE"

-- Test : fixed ignore son argument
test "smocker_fixed_ignores_arg": (let many stub = (S.fixed "X") in (stub 999)) == "X"

-- Test : const_fn equivaut a fixed
test "smocker_const_fn": (let many f = (S.const_fn "OK") in (f "anything")) == "OK"

-- Test : DI isole le vrai http_get
test "smocker_di_isolation": (process (S.fixed 200) "http://ignored") == 200
