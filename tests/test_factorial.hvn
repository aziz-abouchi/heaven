# Tests pour factorial et add

# Définir les fonctions
factorial zero = succ zero
factorial (succ n) = mul (succ n) (factorial n)

add zero n = n
add (succ n) m = succ (add n m)

mul zero m = zero
mul (succ n) m = add m (mul n m)

# Tests
assert_eq factorial zero == succ zero
assert_eq factorial (succ zero) == succ zero
assert_eq factorial (succ (succ zero)) == succ (succ zero)
assert_eq factorial (succ (succ (succ zero))) == succ (succ (succ (succ (succ (succ zero)))))
assert_eq add (succ zero) zero == succ zero
assert_eq add (succ zero) (succ zero) == succ (succ zero)
