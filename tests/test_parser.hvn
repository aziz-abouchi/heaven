-- tests/test_parser.hvn (Jalon 3, phase B)
import "lib/lexer.hvn" as LX
import "lib/parser.hvn" as P

test "lit int": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex "42"))) (P.ELitI 42)) == true
test "sym": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex "x"))) (P.ESym "x")) == true
test "lit string": (let q (let b (raw_alloc 1) (let z (poke_byte b 0 34) (string_of_bytes b 1))) (P.expr_eq (P.pok_expr (P.parse_one (LX.lex (string_concat (string_concat q "ab") q)))) (P.ELitS "ab"))) == true
test "sexpr curryfie": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex "(f a b)"))) (P.EApply (P.EApply (P.ESym "f") (P.ESym "a")) (P.ESym "b"))) == true
test "sexpr sans args": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex "(f)"))) (P.ESym "f")) == true
test "imbrique": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex "(+ 1 (* 2 3))"))) (P.EApply (P.EApply (P.ESym "+") (P.ELitI 1)) (P.EApply (P.EApply (P.ESym "*") (P.ELitI 2)) (P.ELitI 3)))) == true
test "def simple": (P.expr_eq (P.pok_expr (P.parse_top (LX.lex "fac n = (+ n 1)"))) (P.EBind "fac" (P.ELambda "n" (P.EApply (P.EApply (P.ESym "+") (P.ESym "n")) (P.ELitI 1))))) == true
test "def deux params ordre": (P.expr_eq (P.pok_expr (P.parse_top (LX.lex "f x y = (+ x y)"))) (P.EBind "f" (P.ELambda "x" (P.ELambda "y" (P.EApply (P.EApply (P.ESym "+") (P.ESym "x")) (P.ESym "y")))))) == true
test "def sans params": (P.expr_eq (P.pok_expr (P.parse_top (LX.lex "answer = 42"))) (P.EBind "answer" (P.ELitI 42))) == true
test "erreur ) inattendu": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex ")"))) (P.ESym "PARSE_ERR")) == true
test "erreur fin de flux": (P.expr_eq (P.pok_expr (P.parse_one (LX.lex ""))) (P.ESym "PARSE_ERR")) == true
test "fichier deux defs": (P.expr_count (P.parse_file (LX.lex "a = 1 b = 2"))) == 2
test "LE canonique fac": (P.expr_eq (P.pok_expr (P.parse_top (LX.lex "fac n = (if (= n 0) 1 (* n (fac (- n 1))))"))) (P.EBind "fac" (P.ELambda "n" (P.EApply (P.EApply (P.EApply (P.ESym "if") (P.EApply (P.EApply (P.ESym "=") (P.ESym "n")) (P.ELitI 0))) (P.ELitI 1)) (P.EApply (P.EApply (P.ESym "*") (P.ESym "n")) (P.EApply (P.ESym "fac") (P.EApply (P.EApply (P.ESym "-") (P.ESym "n")) (P.ELitI 1)))))))) == true
