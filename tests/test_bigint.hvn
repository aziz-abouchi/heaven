-- tests/test_bigint.hvn -- BigInt v1 (D17-2)

test "from_int / to_int": (to_int (from_int 12345)) == 12345
test "from_int 0": (to_int (from_int 0)) == 0
test "from_int -5": (to_int (from_int (- 0 5))) == (- 0 5)
test "badd petits": (to_int (badd (from_int 12) (from_int 34))) == 46
test "badd carry": (to_int (badd (from_int 999) (from_int 1))) == 1000
test "badd signe + +": (to_int (badd (from_int 10) (from_int 5))) == 15
test "badd signe + -": (to_int (badd (from_int 10) (from_int (- 0 3)))) == 7
test "badd signe - -": (to_int (badd (from_int (- 0 10)) (from_int (- 0 5)))) == (- 0 15)
test "badd signe resultat negatif": (to_int (badd (from_int 3) (from_int (- 0 10)))) == (- 0 7)
test "bsub + -": (to_int (bsub (from_int 10) (from_int 3))) == 7
test "bsub resultat negatif": (to_int (bsub (from_int 3) (from_int 10))) == (- 0 7)
test "bsub negatif moins negatif": (to_int (bsub (from_int (- 0 3)) (from_int (- 0 10)))) == 7
test "bmul 6 x 7": (to_int (bmul (from_int 6) (from_int 7))) == 42
test "bmul 123 x 456": (to_int (bmul (from_int 123) (from_int 456))) == 56088
test "bmul signe + -": (to_int (bmul (from_int 6) (from_int (- 0 7)))) == (- 0 42)
test "bmul signe - -": (to_int (bmul (from_int (- 0 6)) (from_int (- 0 7)))) == 42
test "bto_string 12345": (bto_string (from_int 12345)) == "12345"
test "bto_string 0": (bto_string (from_int 0)) == "0"
test "bto_string -7": (bto_string (from_int (- 0 7))) == "-7"
test "to_string (from_string) roundtrip": (bto_string (from_string "9876543210")) == "9876543210"
test "HUGE 10^26 + 1 > 10^26": (bcmp (badd (from_string "99999999999999999999999999") (from_string "1")) (from_string "99999999999999999999999999")) == 1

test "bdiv 100 / 3 = 33, reste 1": (to_int (bdiv (from_int 100) (from_int 3))) == 33
test "bmod 100 % 3 = 1": (to_int (bmod (from_int 100) (from_int 3))) == 1
test "bmod 1000 % 7 = 6": (to_int (bmod (from_int 1000) (from_int 7))) == 6
test "bdiv 5 / 1 = 5": (to_int (bdiv (from_int 5) (from_int 1))) == 5
test "bdiv 0 / 5 = 0": (to_int (bdiv (from_int 0) (from_int 5))) == 0
test "bmod 0 % 5 = 0": (to_int (bmod (from_int 0) (from_int 5))) == 0
test "bdiv -100 / 3 = -33": (to_int (bdiv (from_int (- 0 100)) (from_int 3))) == (- 0 33)
test "bmod -100 % 3 = -1": (to_int (bmod (from_int (- 0 100)) (from_int 3))) == (- 0 1)

test "TCO + let-in (fix D19)": (bdiv (from_int 500) (from_int 7)) == BPos (BCons 7 (BCons 1 BNil))
test "bdiv 300 / 7 = 42": (to_int (bdiv (from_int 300) (from_int 7))) == 42
