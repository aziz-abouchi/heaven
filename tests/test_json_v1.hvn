-- tests/test_json_v1.hvn — JSON V1 (arrays, objects vides), 2026-10-19.
-- Strings JSON construites via string_of_bytes (escape \" non supporte).
-- Voir docs/spec/_json_object_bug.md pour objects avec cles (H1/H2).

import "stdlib/json/parse.hvn" as JP

-- Arrays
test "arr_empty": (JP.jv_len (JP.json_as_arr_s "[]")) == 0
test "arr_one": (JP.jv_len (JP.json_as_arr_s "[42]")) == 1
test "arr_two": (JP.jv_len (JP.json_as_arr_s "[1,2]")) == 2
test "arr_ws": (JP.jv_len (JP.json_as_arr_s "[1, 2, 3]")) == 3
test "arr_nested": (JP.jv_len (JP.json_as_arr_s "[[1,2],[3]]")) == 2
test "arr_get0": (JP.jv_as_int (JP.jv_get (JP.json_as_arr_s "[10,20,30]") 0)) == 10
test "arr_get2": (JP.jv_as_int (JP.jv_get (JP.json_as_arr_s "[10,20,30]") 2)) == 30

-- Objects : parse {} vide et lookup sur cle absente (retourne JNull)
test "obj_empty_get": (JP.jv_as_int (JP.json_obj_get (JP.json_as_obj_s "{}") "z")) == 0

-- ═══ Objects reels via poke_byte (H1/H2 REFUTES 2026-10-19) ═══
mk_obj _ = (let b (raw_alloc 16) (let z0 (poke_byte b 0 123) (let z1 (poke_byte b 1 34) (let z2 (poke_byte b 2 97) (let z3 (poke_byte b 3 34) (let z4 (poke_byte b 4 58) (let z5 (poke_byte b 5 52) (let z6 (poke_byte b 6 50) (let z7 (poke_byte b 7 125) (string_of_bytes b 8))))))))))
test "obj_one_key_hit": (JP.jv_as_int (JP.json_obj_get (JP.json_as_obj_s (mk_obj 0)) "a")) == 42
test "obj_one_key_miss": (JP.jv_as_int (JP.json_obj_get (JP.json_as_obj_s (mk_obj 0)) "z")) == 0
