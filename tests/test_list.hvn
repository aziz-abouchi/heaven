-- tests/test_list.hvn
-- Module List : fonctions de base + isEmpty, singleton, last,
-- init, uncons.
-- Inspire de maryamyriameliamurphies.js.

-- ─── head / tail / length ───
test "head":            (head (cons 1 (cons 2 nil))) == 1
test "tail head":       (head (tail (cons 1 (cons 2 nil)))) == 2
test "length nil":      (length nil) == zero
test "length 3":        (length (cons 1 (cons 2 (cons 3 nil)))) == (succ (succ (succ zero)))

-- ─── null / isEmpty ───
test "null nil":        (null nil) == true
test "null 1":          (null (cons 1 nil)) == false
test "isEmpty nil":     (isEmpty nil) == true
test "isEmpty 1":       (isEmpty (cons 1 nil)) == false

-- ─── singleton ───
test "singleton length": (length (singleton 42)) == (succ zero)
test "singleton head":   (head (singleton 42)) == 42

-- ─── last ───
test "last 1":          (last (cons 42 nil)) == 42
test "last 3":          (last (cons 1 (cons 2 (cons 3 nil)))) == 3

-- ─── init ───
test "init 1 element":  (length (init (cons 42 nil))) == zero
test "init 3 length":   (length (init (cons 1 (cons 2 (cons 3 nil))))) == (succ (succ zero))
test "init head":       (head (init (cons 1 (cons 2 (cons 3 nil))))) == 1
test "init last":       (last (init (cons 1 (cons 2 (cons 3 nil))))) == 2

-- ─── uncons ───
test "uncons nil":      (is_none (uncons nil)) == true
test "uncons head":     (fst (from_option (pair 0 nil) (uncons (cons 7 (cons 8 nil))))) == 7
test "uncons tail":     (head (snd (from_option (pair 0 nil) (uncons (cons 7 (cons 8 nil)))))) == 8

-- ─── takeWhile ───
lt5 x = (< x 5)
test "takeWhile lt5 [1,2,3,6,4]": (length (takeWhile lt5 (cons 1 (cons 2 (cons 3 (cons 6 (cons 4 nil))))))) == (succ (succ (succ zero)))
test "takeWhile vide":            (length (takeWhile lt5 nil)) == zero

-- ─── dropWhile ───
test "dropWhile lt5 [1,2,3,6,4]": (head (dropWhile lt5 (cons 1 (cons 2 (cons 3 (cons 6 (cons 4 nil))))))) == 6
test "dropWhile vide":            (length (dropWhile lt5 nil)) == zero

-- ─── splitAt ───
test "splitAt 0":        (length (fst (splitAt zero (cons 1 (cons 2 nil))))) == zero
test "splitAt 1 first":  (head (fst (splitAt (succ zero) (cons 1 (cons 2 nil))))) == 1
test "splitAt 1 second": (head (snd (splitAt (succ zero) (cons 1 (cons 2 nil))))) == 2

-- ─── find ───
gt0 x = (> x 0)
is5 x = (eq x 5)
test "find nil":    (is_none (find gt0 nil)) == true
test "find 5":      (from_option 0 (find is5 (cons 1 (cons 5 (cons 3 nil))))) == 5

-- ─── any ───
test "any gt0 [1,2]":  (any gt0 (cons 1 (cons 2 nil))) == true
test "any nil":        (any gt0 nil) == false

-- ─── Lot 2.3 : intersperse, replicate, nub, lookup, elemIndex, concat_map ───

-- intersperse
test "intersperse head":  (head (intersperse 0 (cons 1 (cons 2 (cons 3 nil))))) == 1
test "intersperse len":   (length (intersperse 0 (cons 1 (cons 2 (cons 3 nil))))) == 5

-- replicate
test "replicate 3 len":   (length (replicate 3 42)) == 3
test "replicate 0 len":   (length (replicate 0 42)) == zero
test "replicate head":    (head (replicate 2 7)) == 7

-- nub
test "nub [1,1,2] len":   (length (nub (cons 1 (cons 1 (cons 2 nil))))) == 2
test "nub [1,2,1] len":   (length (nub (cons 1 (cons 2 (cons 1 nil))))) == 2
test "nub [1,2,3] len":   (length (nub (cons 1 (cons 2 (cons 3 nil))))) == 3

-- lookup
test "lookup 1":          (from_option 0 (lookup 1 (cons (pair 1 10) (cons (pair 2 20) nil)))) == 10
test "lookup 2":          (from_option 0 (lookup 2 (cons (pair 1 10) (cons (pair 2 20) nil)))) == 20
test "lookup absente":    (is_none (lookup 99 (cons (pair 1 10) nil))) == true

-- elemIndex
test "elemIndex 0":       (from_option 99 (elemIndex 1 (cons 1 (cons 2 nil)))) == 0
test "elemIndex 1":       (from_option 99 (elemIndex 2 (cons 1 (cons 2 nil)))) == 1
test "elemIndex absente": (is_none (elemIndex 99 (cons 1 (cons 2 nil)))) == true

-- concat_map
double x = (cons x (cons x nil))
test "concat_map len":    (length (concat_map double (cons 1 (cons 2 nil)))) == 4
test "concat_map head":   (head (concat_map double (cons 1 (cons 2 nil)))) == 1
