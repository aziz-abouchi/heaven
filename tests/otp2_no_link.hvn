fn step(s, m) = m s

test "no_link_survives":
  (let many a = (spawn step 0) in
   (let many b = (spawn step 0) in
    (let many _ = (exit a) in
     (is_alive b)))) == true

test "no_link_both_alive":
  (let many a = (spawn step 0) in
   (let many b = (spawn step 0) in
    (and (is_alive a) (is_alive b)))) == true
