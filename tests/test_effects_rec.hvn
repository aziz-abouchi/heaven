-- tests/test_effects_rec.hvn -- handle_rec (D8 3a-3-b)

test "handle_rec countdown 5": (handle_rec (lambda s -> (if (= s 0) 0 (perform "tick" s))) (lambda v k -> (if (= v 0) 0 (k (- v 1)))) 5) == 0

test "handle_rec sum jusqu'a 3": (handle_rec (lambda s -> (if (= s 3) s (perform "next" s))) (lambda v k -> (k (+ v 1))) 0) == 3

test "handle_rec one-shot (handler sans k)": (handle_rec (lambda s -> (perform "once" s)) (lambda v k -> v) 42) == 42

test "handle_rec 10 iterations": (handle_rec (lambda s -> (if (= s 0) 0 (perform "dec" s))) (lambda v k -> (k (- v 1))) 10) == 0
