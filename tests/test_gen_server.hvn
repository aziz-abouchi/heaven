-- tests/test_gen_server.hvn — validation O1 (préemptif sur linux-x86_64)

inc x = + x 1

test "gen_server_cast_call":
  let pid = gen_server_spawn 0 in
  let _   = gen_server_cast pid inc in
  let _   = gen_server_cast pid inc in
  let v   = gen_server_call pid inc in
  v == 3

test "gen_server_state_persist":
  let pid = gen_server_spawn 10 in
  let _   = gen_server_cast pid inc in
  let _   = gen_server_cast pid inc in
  let v   = gen_server_call pid (lambda x. x) in
  v == 12
