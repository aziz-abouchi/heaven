import "core/std/smocker.hvn" as S
import "hab/component.hvn"
import "hab/render/html.hvn"

test "render_children_order":
  (let many s0 = (S.mock "ok") in
   (let many s1 = (S.call s0 "a") in
    (let many s2 = (S.call s1 "b") in
     (let many s3 = (S.call s2 "c") in
      (S.verify s3 (cons "c" (cons "b" (cons "a" nil)))))))) == true

test "render_leaf_no_alloc":
  (html_render (leaf "")) == ""
