import "hab/app.hvn"
import "core/std/otp/supervisor.hvn"
inc s m = (s + m)
test "app_3children_count":
  (let many c1 = (child_mk inc 0) in
   (let many c2 = (child_mk inc 10) in
    (let many c3 = (child_mk inc 20) in
     (let many app = (app_mk (cons c1 (cons c2 (cons c3 nil)))) in
      (let many app2 = (app_tick_all app 5) in
       (app_count app2)))))) == 3
