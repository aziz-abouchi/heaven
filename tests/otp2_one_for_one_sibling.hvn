-- Comparaison : one_for_one préserve les voisins, contrairement à one_for_all.
fn step(s, m) = m s

test "one_for_one_keeps_sibling":
  (let many sup = (sup_spawn_with sup_restart_one step (cons 0 (cons 0 nil))) in
   (let many s0 = (run sup) in
    (let many p1 = (sup_p1 s0) in
     (let many p2 = (sup_p2 s0) in
      (let many _ = (exit p1 1) in
       (let many s1 = (sup_tick_with sup) in
        (let many p2b = (sup_p2 s1) in
         (p2 == p2b)))))))) == true
