-- tests/test_propagator.hvn — cellules + propagateurs V0 (2026-11-02)
-- Cadrage : docs/spec/_propagators.md
import "lib/heaven_propagator.hvn" as P

-- ─── Construction ───
test "cell_id": (P.cell_id (P.cell "x" 5)) == "x"
test "cell_val": (P.cell_val (P.cell "x" 5)) == 5

-- ─── Merge : 4 lois ───
test "merge_commutatif": (P.cell_val (P.cell_merge (P.cell "x" 3) (P.cell "x" 7))) == (P.cell_val (P.cell_merge (P.cell "x" 7) (P.cell "x" 3)))
test "merge_associatif":
  (P.cell_val (P.cell_merge (P.cell_merge (P.cell "x" 1) (P.cell "x" 2)) (P.cell "x" 3))) ==
  (P.cell_val (P.cell_merge (P.cell "x" 1) (P.cell_merge (P.cell "x" 2) (P.cell "x" 3))))
test "merge_idempotent": (P.cell_val (P.cell_merge (P.cell "x" 5) (P.cell "x" 5))) == 5

-- ─── Merge : résultat (max) ───
test "merge_max_1": (P.cell_val (P.cell_merge (P.cell "x" 3) (P.cell "x" 7))) == 7
test "merge_max_2": (P.cell_val (P.cell_merge (P.cell "x" 7) (P.cell "x" 3))) == 7

-- ─── Propagateur ───
-- prop : ajoute 10 à la valeur
add10 c = (P.cell (P.cell_id c) (+ (P.cell_val c) 10))
test "propagate_add10": (P.cell_val (P.propagate (P.cell "x" 5) add10)) == 15

-- ─── Chaîne 2 propagateurs ───
add100 c = (P.cell (P.cell_id c) (+ (P.cell_val c) 100))
test "propagate2": (P.cell_val (P.propagate2 (P.cell "x" 5) add10 add100)) == 115

-- ─── Ordre induit ───
test "cell_le": (P.cell_le (P.cell "x" 3) (P.cell "x" 7)) == true
test "cell_not_le": (P.cell_le (P.cell "x" 7) (P.cell "x" 3)) == false

-- ─── V1.1 : semilattice min (ordre inversé) ───
test "v11_min_commutatif":
  (P.cell_val (P.cell_merge_min (P.cell "x" 3) (P.cell "x" 7))) ==
  (P.cell_val (P.cell_merge_min (P.cell "x" 7) (P.cell "x" 3)))
test "v11_min_associatif":
  (P.cell_val (P.cell_merge_min (P.cell_merge_min (P.cell "x" 1) (P.cell "x" 2)) (P.cell "x" 3))) ==
  (P.cell_val (P.cell_merge_min (P.cell "x" 1) (P.cell_merge_min (P.cell "x" 2) (P.cell "x" 3))))
test "v11_min_idempotent": (P.cell_val (P.cell_merge_min (P.cell "x" 5) (P.cell "x" 5))) == 5

-- ─── V1.1 : semilattice or (0 <= 1) ───
test "v11_or_commutatif":
  (P.cell_val (P.cell_merge_or (P.cell "x" 0) (P.cell "x" 1))) ==
  (P.cell_val (P.cell_merge_or (P.cell "x" 1) (P.cell "x" 0)))
test "v11_or_associatif":
  (P.cell_val (P.cell_merge_or (P.cell_merge_or (P.cell "x" 1) (P.cell "x" 0)) (P.cell "x" 1))) ==
  (P.cell_val (P.cell_merge_or (P.cell "x" 1) (P.cell_merge_or (P.cell "x" 0) (P.cell "x" 1))))
test "v11_or_idempotent": (P.cell_val (P.cell_merge_or (P.cell "x" 1) (P.cell "x" 1))) == 1
test "v11_or_zero_one": (P.cell_val (P.cell_merge_or (P.cell "x" 0) (P.cell "x" 1))) == 1

-- ─── V1.2 : semilattice ensembliste (union_list) ───
-- Note : en tant que listes, l'ordre diffère entre a ⊕ b et b ⊕ a.
-- Les lois sont observées via (length), invariant ensembliste.

test "v12_union_idem":
  (length (P.cell_val (P.cell_merge_union
    (P.cell "x" (cons 1 (cons 2 nil)))
    (P.cell "x" (cons 1 (cons 2 nil)))))) == (succ (succ zero))

test "v12_union_commut_len":
  (length (P.cell_val (P.cell_merge_union
    (P.cell "x" (cons 1 (cons 2 nil)))
    (P.cell "x" (cons 2 (cons 3 nil)))))) ==
  (length (P.cell_val (P.cell_merge_union
    (P.cell "x" (cons 2 (cons 3 nil)))
    (P.cell "x" (cons 1 (cons 2 nil))))))

test "v12_union_assoc_len":
  (length (P.cell_val (P.cell_merge_union
    (P.cell_merge_union
      (P.cell "x" (cons 1 nil))
      (P.cell "x" (cons 2 nil)))
    (P.cell "x" (cons 3 nil))))) ==
  (length (P.cell_val (P.cell_merge_union
    (P.cell "x" (cons 1 nil))
    (P.cell_merge_union
      (P.cell "x" (cons 2 nil))
      (P.cell "x" (cons 3 nil))))))

test "v12_union_card":
  (length (P.cell_val (P.cell_merge_union
    (P.cell "x" (cons 1 (cons 2 nil)))
    (P.cell "x" (cons 2 (cons 3 nil)))))) == (succ (succ (succ zero)))

-- ─── V1.2 : watch (chaîne de propagateurs) ───
test "v12_watch_1":
  (P.cell_val (P.watch (P.cell "x" 5) (cons add10 nil))) == 15

test "v12_watch_2":
  (P.cell_val (P.watch (P.cell "x" 5) (cons add10 (cons add100 nil)))) == 115

