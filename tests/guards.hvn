# Guards — clauses gardées (ROADMAP : « jamais implémentés » → ici)

clamp x | x < 0 = 0
clamp x | x > 9 = 9
clamp x | otherwise = x

signe x | x < 0 = 0 - 1
signe x | x == 0 = 0
signe x | true = 1

test "guard_clamp_low": (clamp (0 - 5)) == 0
test "guard_clamp_mid": (clamp 5) == 5
test "guard_clamp_high": (clamp 15) == 9
test "guard_order_first_wins": (signe (0 - 3)) == (0 - 1)
test "guard_eq_zero": (signe 0) == 0
test "guard_fallthrough": (signe 7) == 1

nonGuard x = x
test "guard_absent_inchange": (nonGuard 42) == 42

categorie n | n <= 0 = 0 - 1
categorie n | otherwise = 1
test "guard_le_token": (categorie (0 - 1)) == (0 - 1)

# ── Forme alignee (continuation de clause) ──
classifie x | x < 0 = 0 - 1
            | x == 0 = 0
            | otherwise = 1
test "aligne_classifie_neg": (classifie (0 - 3)) == (0 - 1)
test "aligne_classifie_zero": (classifie 0) == 0
test "aligne_classifie_pos": (classifie 7) == 1

# Continuation apres clause non gardee : le LHS de base est repris nu
grade n | n >= 90 = 4
         | n >= 80 = 3
grade n = 2
test "aligne_apres_nu": (grade 95) == 4
test "aligne_default": (grade 50) == 2
