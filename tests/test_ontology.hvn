-- tests/test_ontology.hvn — KB en .hvn pur (2026-10-20)
import "stdlib/ontology.hvn" as O

kb _ = (O.Kcons
  (O.MkTriple "socrate" "type" "homme")
  (O.Kcons
    (O.MkTriple "socrate" "age" "70")
    (O.Kcons
      (O.MkTriple "platon" "type" "homme")
      (O.Kcons
        (O.MkTriple "platon" "teacherOf" "aristote")
        O.Knil))))

test "size": (O.kb_size (kb unit)) == 4
test "subject": (O.subject (O.MkTriple "a" "b" "c")) == "a"
test "predicate": (O.predicate (O.MkTriple "a" "b" "c")) == "b"
test "object": (O.object (O.MkTriple "a" "b" "c")) == "c"
test "query_age": (O.kb_query (kb unit) "socrate" "age") == "70"
test "query_type": (O.kb_query (kb unit) "platon" "type") == "homme"
test "query_absent": (O.kb_query (kb unit) "socrate" "xxx") == ""
test "has_true": (O.kb_has (kb unit) "platon" "type" "homme") == true
test "has_false": (O.kb_has (kb unit) "platon" "age" "70") == false
test "count_homme": (O.kb_count (kb unit) "socrate" "type") == 1
test "filter_socrate": (O.kb_size (O.filter_subj "socrate" (kb unit))) == 2
test "filter_homme": (O.kb_size (O.filter_pred "type" (kb unit))) == 2
