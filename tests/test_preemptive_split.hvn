-- Test B-lite : reprise après split de budget sur expression plate
test "split budget (+ 1 2)":
  (let t (add_task (lambda s -> (+ 1 2)) 0)
   (let _ (schedule 1)
    (let _ (schedule 100)
     (task_state t)))) == 3

test "split budget (+ 1 2 3 4)":
  (let t (add_task (lambda s -> (+ 1 2 3 4)) 0)
   (let _ (schedule 2)
    (let _ (schedule 100)
     (task_state t)))) == 10
