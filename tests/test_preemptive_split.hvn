-- tests/test_preemptive_split.hvn
-- Verifie qu'une tache suspendue par budget insuffisant est
-- reprise au prochain schedule (A-3a : TaskState.preempted).

test "split budget (+ 1 2) : 1 + 100":
  (let t (add_task (lambda s -> (+ 1 2)) 0)
   (let _ (schedule 1)
    (let _ (schedule 100)
     (task_state t)))) == 3

test "split budget (+ 1 2 3 4) : 2 + 100":
  (let t (add_task (lambda s -> (+ 1 2 3 4)) 0)
   (let _ (schedule 2)
    (let _ (schedule 100)
     (task_state t)))) == 10

test "split budget : 3 schedules successifs":
  (let t (add_task (lambda s -> (+ 40 2)) 0)
   (let _ (schedule 1)
    (let _ (schedule 1)
     (let _ (schedule 100)
      (task_state t))))) == 42
