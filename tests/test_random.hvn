import "lib/random.hvn" as R

above lo v = ge v lo
below hi v = le v hi
different a b = not (a == b)

test "lcg_det": R.lcg_next 42 == R.lcg_next 42
test "lcg_var": different (R.lcg_next 42) (R.lcg_next 43) == true
test "seed_zero": R.seed 0 == 1
test "seed_42": R.seed 42 == 42
test "range_lo": above 1 (R.rand_range 42 1 6) == true
test "range_hi": below 6 (R.rand_range 42 1 6) == true
test "bool_det": R.rand_bool 42 == R.rand_bool 42
test "abs_pos_neg": R.abs_pos (0 - 5) == 5
test "abs_pos_pos": R.abs_pos 5 == 5
