-- tests/mcp/registry_export.hvn — sérialisation JSON du registre (Session 46)
-- Note : pas de '{' ni '}' littéraux dans les assertions. Le splitter
-- de test_runner.zig compte naïvement les accolades et absorbe les
-- lignes suivantes. On utilise peek_byte avec les codes ASCII :
--   123 = '{', 125 = '}', 34 = '"'
import "lib/tool_registry.hvn" as TR
import "stdlib/string.hvn"

json_str = TR.registry_to_json 0

find_str_from s pat i =
  if i + (string_length pat) > (string_length s) then 0 - 1
  else if (string_matches_at s i pat) then i
  else find_str_from s pat (i + 1)

contains s pat = (find_str_from s pat 0) >= 0

first_byte _ = peek_byte (string_ptr json_str) 0
len _ = string_length json_str
last_byte _ = peek_byte (string_ptr json_str) (len 0 - 1)

test "starts_open_brace": first_byte 0 == 123
test "ends_close_brace": last_byte 0 == 125

test "has_tools_key": contains json_str "tools" == true
test "has_echo": contains json_str "echo" == true
test "has_fs_read": contains json_str "fs_read" == true
test "has_heaven_eval": contains json_str "heaven_eval" == true
test "has_heaven_prove": contains json_str "heaven_prove" == true
test "has_mlcpd_parse": contains json_str "mlcpd_parse" == true

test "kind_0": contains json_str "kind" == true
test "kind_heaven": contains json_str ":0" == true
test "kind_native": contains json_str ":1" == true

test "inputSchema": contains json_str "inputSchema" == true
test "no_trailing_comma": contains json_str ",]" == false
