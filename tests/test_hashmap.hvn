-- tests/test_hashmap.hvn (Jalon 2, v0)
-- HashMap Int -> Int via open addressing.

test "new : length = 0": (let m (map_new 8) (map_length m)) == 0

test "new : capacity = 8": (let m (map_new 8) (map_capacity m)) == 8

test "get sur map vide = 0": (let m (map_new 8) (map_get m 42)) == 0

test "has sur map vide = 0": (let m (map_new 8) (map_has m 42)) == 0

test "put 1 + length = 1": (let m (map_put (map_new 8) 1 10) (map_length m)) == 1

test "put 1 + get = 10": (let m (map_put (map_new 8) 1 10) (map_get m 1)) == 10

test "put 1 + has = 1": (let m (map_put (map_new 8) 1 10) (map_has m 1)) == 1

test "put 2 cles distinctes + length = 2": (let m0 (map_new 8) (let m1 (map_put m0 1 10) (let m2 (map_put m1 2 20) (map_length m2)))) == 2

test "put 2 + get cle 1 = 10": (let m0 (map_new 8) (let m1 (map_put m0 1 10) (let m2 (map_put m1 2 20) (map_get m2 1)))) == 10

test "put 2 + get cle 2 = 20": (let m0 (map_new 8) (let m1 (map_put m0 1 10) (let m2 (map_put m1 2 20) (map_get m2 2)))) == 20

test "put 2 + get cle absente = 0": (let m0 (map_new 8) (let m1 (map_put m0 1 10) (let m2 (map_put m1 2 20) (map_get m2 99)))) == 0

-- ─── Cas avances ───
test "overwrite : put meme cle 2x garde length = 1": (let m0 (map_new 8) (let m1 (map_put m0 5 100) (let m2 (map_put m1 5 200) (map_length m2)))) == 1

test "overwrite : derniere valeur gagne": (let m0 (map_new 8) (let m1 (map_put m0 5 100) (let m2 (map_put m1 5 200) (map_get m2 5)))) == 200

test "collision : cles 0 et 8 sur cap 8": (let m0 (map_new 8) (let m1 (map_put m0 0 10) (let m2 (map_put m1 8 80) (map_get m2 8)))) == 80

test "collision : cle 0 intacte apres collision": (let m0 (map_new 8) (let m1 (map_put m0 0 10) (let m2 (map_put m1 8 80) (map_get m2 0)))) == 10

test "resize : 7 cles distinctes sur cap 8 declenche resize": (let m0 (map_new 8) (let m1 (map_put m0 1 1) (let m2 (map_put m1 2 2) (let m3 (map_put m2 3 3) (let m4 (map_put m3 4 4) (let m5 (map_put m4 5 5) (let m6 (map_put m5 6 6) (let m7 (map_put m6 7 7) (map_length m7))))))))) == 7

test "resize : capacity doublee apres 7 puts": (let m0 (map_new 8) (let m1 (map_put m0 1 1) (let m2 (map_put m1 2 2) (let m3 (map_put m2 3 3) (let m4 (map_put m3 4 4) (let m5 (map_put m4 5 5) (let m6 (map_put m5 6 6) (let m7 (map_put m6 7 7) (map_capacity m7))))))))) == 16

test "resize : toutes les cles survivent": (let m0 (map_new 8) (let m1 (map_put m0 1 10) (let m2 (map_put m1 2 20) (let m3 (map_put m2 3 30) (let m4 (map_put m3 4 40) (let m5 (map_put m4 5 50) (let m6 (map_put m5 6 60) (let m7 (map_put m6 7 70) (map_get m7 4))))))))) == 40

-- ─── Edges (session 2026-10-09) ───
test "cle negative : get": (let m (map_put (map_new 8) (- 0 5) 99) (map_get m (- 0 5))) == 99
test "cle negative : has": (let m (map_put (map_new 8) (- 0 5) 99) (map_has m (- 0 5))) == 1
test "cap 0 ne panique pas": (let m (map_put (map_new 0) 1 10) (map_get m 1)) == 10
test "map_free s'execute": (let m (map_put (map_new 8) 1 10) (let z (map_free m) 1)) == 1
test "map_free apres resize": (let m0 (map_new 2) (let m1 (map_put m0 1 10) (let m2 (map_put m1 2 20) (let z (map_free m2) 1)))) == 1

-- ─── v1 : Str -> Int (chaining) ───
test "smap get absent = 0": (smap_get (smap_new 8) "zz") == 0
test "smap put/get": (let m (smap_put (smap_new 8) "un" 1) (smap_get m "un")) == 1
test "smap has present": (let m (smap_put (smap_new 8) "un" 1) (smap_has m "un")) == 1
test "smap has absent": (smap_has (smap_new 8) "zz") == 0
test "smap deux cles": (let m0 (smap_new 8) (let m1 (smap_put m0 "un" 1) (let m2 (smap_put m1 "deux" 2) (smap_get m2 "deux")))) == 2
test "smap overwrite": (let m0 (smap_new 8) (let m1 (smap_put m0 "k" 10) (let m2 (smap_put m1 "k" 20) (smap_get m2 "k")))) == 20
test "smap overwrite garde taille": (let m0 (smap_new 8) (let m1 (smap_put m0 "k" 10) (let m2 (smap_put m1 "k" 20) (smap_size m2)))) == 1
test "smap chainage cap 1": (let m0 (smap_new 1) (let m1 (smap_put m0 "a" 1) (let m2 (smap_put m1 "b" 2) (let m3 (smap_put m2 "c" 3) (smap_get m3 "b"))))) == 2
test "smap chainage toutes survivent": (let m0 (smap_new 1) (let m1 (smap_put m0 "a" 1) (let m2 (smap_put m1 "b" 2) (let m3 (smap_put m2 "c" 3) (+ (smap_get m3 "a") (+ (smap_get m3 "b") (smap_get m3 "c"))))))) == 6
test "smap prefixes ab/abc": (let m0 (smap_new 8) (let m1 (smap_put m0 "ab" 1) (let m2 (smap_put m1 "abc" 2) (+ (smap_get m2 "ab") (smap_get m2 "abc"))))) == 3
test "smap del tete": (let m0 (smap_new 1) (let m1 (smap_put m0 "a" 1) (let m2 (smap_put m1 "b" 2) (let d (smap_del m2 "b") (smap_get m2 "a"))))) == 1
test "smap del milieu": (let m0 (smap_new 1) (let m1 (smap_put m0 "a" 1) (let m2 (smap_put m1 "b" 2) (let m3 (smap_put m2 "c" 3) (let d (smap_del m3 "b") (+ (smap_get m3 "a") (smap_get m3 "c"))))))) == 4
test "smap del puis get = 0": (let m0 (smap_new 8) (let m1 (smap_put m0 "k" 5) (let d (smap_del m1 "k") (smap_get m1 "k")))) == 0
test "smap del absent = 0": (smap_del (smap_new 8) "zz") == 0
test "smap_free s'execute": (let m (smap_put (smap_new 8) "k" 1) (let z (smap_free m) 1)) == 1
test "smap_free apres del": (let m0 (smap_new 1) (let m1 (smap_put m0 "a" 1) (let m2 (smap_put m1 "b" 2) (let d (smap_del m2 "a") (let z (smap_free m2) 1))))) == 1
