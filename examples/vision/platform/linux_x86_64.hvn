-- core/platform/linux_x86_64.hvn (syntaxe reelle, D10)
-- Appels libc via le prefixe @nom (Path B).

read fd buf len  = @read  fd buf len
write fd buf len = @write fd buf len
open path flags  = @open  path flags
close fd         = @close fd
alloc size       = @mmap  0 size 3 34 -1 0
free ptr size    = @munmap ptr size

-- Expression finale (racine pour compile-qbe).
(write 1 0 0)
