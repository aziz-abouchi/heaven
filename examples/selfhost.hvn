-- Heaven self-hosting test

fn square(x: i64) -> i64 { return x * x; }

fn cube(x: i64) -> i64 { return x * x * x; }

fn power(base: i64, exp: i64) -> i64 { if exp <= 0 { return 1; } return base * power(base, exp - 1); }

fn is_even(n: i64) -> i64 { match n { 0 => { return 1; }, 1 => { return 0; }, _ => { return is_even(n - 2); }, } }

fn sum_range(lo: i64, hi: i64) -> i64 { let total = 0; for i in lo..hi { total += i; } return total; }

struct Result { value: i64, ok: i64, }

fn main() { print(square(7)); print(cube(3)); print(power(2, 10)); print(is_even(42)); print(is_even(17)); print(sum_range(1, 101)); let r = Result { value: 42, ok: 1 }; print("All tests passed!"); }