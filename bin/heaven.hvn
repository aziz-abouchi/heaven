-- bin/heaven.hvn — CLI auto-hebergee, V0.6 (dispatch @strcmp)
-- Usage : ./bin/heaven-natif <cmd>
--   version → exit 1
--   help    → exit 2
--   autre   → exit 0
--
-- Note : multi-clauses (G.25) pas encore dispo → if imbriqués + @strcmp
main = (if (= (@strcmp (@argv 1) "version") 0) 1 (if (= (@strcmp (@argv 1) "help") 0) 2 0))
