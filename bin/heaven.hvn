-- bin/heaven.hvn — CLI auto-hebergee, V0.1
-- IMPORTANT : parseLastExpr est ligne-par-ligne, donc les définitions
-- doivent tenir sur UNE SEULE LIGNE (pas de multi-ligne).

dispatch x = (if (= x 0) 0 (if (= x 1) 1 (if (= x 2) 2 (if (= x 3) 3 (if (= x 4) 4 (if (= x 5) 5 99))))))
main = (dispatch 2)
